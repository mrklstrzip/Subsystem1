@{
    ViewBag.Title = "Dashboard";
}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,200..800;1,6..72,200..800&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap" rel="stylesheet">
<link href="@Url.Content("~/Content/css/dashboard.css")?v=1.0" rel="stylesheet" type="text/css" />

<h1 class="page-title">Dashboard</h1>

<div class="admin-cards">
    <div class="card">
        <h4 class="card-title">TOTAL USER</h4>
        <p class="number" id="dash-total">0</p>
        <span class="card-description">All registered accounts</span>
    </div>

    <div class="card">
        <h4 class="card-title">STUDENT</h4>
        <p class="number" id="dash-students">0</p>
        <span class="card-description">Registered student accounts</span>
    </div>

    <div class="card">
        <h4 class="card-title">PROFESSOR/PANELIST</h4>
        <p class="number" id="dash-professors">0</p>
        <span class="card-description">Registered professor/panelist accounts</span>
    </div>

    <div class="card">
        <h4 class="card-title">CAPSTONE COORDINATOR</h4>
        <p class="number" id="dash-coordinators">0</p>
        <span class="card-description">Registered capstone coordinator accounts</span>
    </div>

    <div class="card">
        <h4 class="card-title">CAMPUS DIRECTOR</h4>
        <p class="number" id="dash-directors">0</p>
        <span class="card-description">Registered campus director accounts</span>
    </div>

</div>

<div class="tables">
    <div class="activity">
        <h4 class="table-title">RECENT ACCOUNT ACTIVITY</h4>
        <table class="activity-table">
            <thead>
                <tr>
                    <th class="column-title actdate-col">DATE</th>
                    <th class="column-title">ACTIVITY</th>
                </tr>
            </thead>
            <tbody id="dash-activity"></tbody>
        </table>
    </div>

    <div class="distribution">
        <h4 class="table-title">ROLE DISTRIBUTION</h4>
        <table class="distribution-table">
            <thead>
                <tr>
                    <th class="column-title role-col">ROLE</th>
                    <th class="column-title num-col">TOTAL</th>
                    <th class="column-title num-col">ACTIVE</th>
                    <th class="column-title num-col">INACTIVE</th>
                </tr>
            </thead>
            <tbody id="dash-roles"></tbody>
        </table>
    </div>
</div>

<script src="@Url.Content("~/Scripts/admin-app.js")?v=1.0"></script>
