@{
    ViewBag.Title = "Dashboard";
}


<style>
    .page-title {
        padding-bottom: 30px;
        font-weight: 600;
    }
    .admin-cards {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        column-gap: 30px;
        row-gap: 15px;
        margin-bottom: 50px;
    }

    .card {
        background-color: #ffffff;
        border-radius: 10px;
        border: solid 1px;
        border-color: #DFDBDB;
        padding: 10px;
        box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.2);
        height: 120px;
    }

        .card-title {
            color: #9092AD;
            padding: 10px;
        }

        .number {
            font-size: 30px;
            font-weight: 600;
            padding: 0 10px;
        }

        .card-description {
            color: #9092AD;
            font-size: 12px;
            padding: 10px;
        }


    .tables {
        display: grid;
        grid-template-columns: 1fr 1fr;
        column-gap: 30px;
        row-gap: 15px;
        margin-bottom: 50px;
    }

    .activity,
    .distribution {
        background-color: #ffffff;
        border-radius: 10px;
        border: solid 1px #DFDBDB;
        padding: 15px 20px;
        box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.2);
        height: 300px;
        margin-bottom: 20px;
    }

    .table-title {
        color: #9092AD;
        margin: 0 0 15px 0;
        font-size: 14px;
        letter-spacing: 0.5px;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    .column-title {
        color: #9092AD;
        font-weight: 600;
        font-size: 13px;
        padding-bottom: 8px;
    }

    td {
        padding: 4px 0;
        font-size: 13px;
    }

    .bold {
        font-weight: 600;
    }

    .activity-table {
        text-align: left;
    }

    .actdate-col {
        width: 120px;
    }

    .actdate {
        color: #333333;
    }

    .role-col {
        text-align: left;
    }

    .num-col {
        text-align: center;
        width: 120px;
    }

    .role-name {
        text-align: left;
    }

    .total-num,
    .active-num,
    .inactive-num {
        text-align: center;
    }

</style>

<h1 class="page-title" >Dashboard</h1>

<div class="admin-cards">
    <div class="card">
        <h4 class="card-title">TOTAL USER</h4>
        <p class="number">84</p>
        <span class="card-description">All registered accounts</span>
    </div>

    <div class="card">
        <h4 class="card-title">STUDENT</h4>
        <p class="number">62</p>
        <span class="card-description">Registered student accounts</span>
    </div>

    <div class="card">
        <h4 class="card-title">PROFESSOR/PANELIST</h4>
        <p class="number">18</p>
        <span class="card-description">Registered professor/panelist accounts</span>
    </div>

    <div class="card">
        <h4 class="card-title">CAPSTONE COORDINATOR</h4>
        <p class="number">2</p>
        <span class="card-description">Registered capstone coordinator accounts</span>
    </div>

    <div class="card">
        <h4 class="card-title">CAMPUS DIRECTOR</h4>
        <p class="number">1</p>
        <span class="card-description">Registered campus director accounts</span>
    </div>

</div>

<div class="tables">
    <div class="activity">
        <h4 class="table-title">RECENT ACCOUNT ACTIVITY</h4>
        <table class="activity-table">
            <thead>
                <tr>
                    <th class="column-title actdate-col">DATE</th>
                    <th class="column-title">ACTIVITY</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td class="actdate">04-25-2026</td>
                    <td class="actname bold">New student account created: Alden Richards</td>
                </tr>
                <tr>
                    <td class="actdate">04-25-2026</td>
                    <td class="actname bold">Faculty profile updated: Dr. Sam Amor</td>
                </tr>
                <tr>
                    <td class="actdate">04-25-2026</td>
                    <td class="actname bold">Account deactivated: Julian Alcantara (Student)</td>
                </tr>
                <tr>
                    <td class="actdate">04-25-2026</td>
                    <td class="actname bold">New Expertise Tag created: Networking</td>
                </tr>
                <tr>
                    <td class="actdate">04-25-2026</td>
                    <td class="actname bold">Expertise Tag modified: Artificial Intelligence</td>
                </tr>
                <tr>
                    <td class="actdate">04-25-2026</td>
                    <td class="actname bold">New student account created: Sean Sequitin</td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="distribution">
        <h4 class="table-title">ROLE DISTRIBUTION</h4>
        <table class="distribution-table">
            <thead>
                <tr>
                    <th class="column-title role-col">ROLE</th>
                    <th class="column-title num-col">TOTAL</th>
                    <th class="column-title num-col">ACTIVE</th>
                    <th class="column-title num-col">INACTIVE</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td class="role-name bold">Student</td>
                    <td class="total-num bold">62</td>
                    <td class="active-num bold">58</td>
                    <td class="inactive-num bold">4</td>
                </tr>
                <tr>
                    <td class="role-name bold">Professor/Panelist</td>
                    <td class="total-num bold">18</td>
                    <td class="active-num bold">18</td>
                    <td class="inactive-num bold">0</td>
                </tr>
                <tr>
                    <td class="role-name bold">Capstone Coordinator</td>
                    <td class="total-num bold">2</td>
                    <td class="active-num bold">2</td>
                    <td class="inactive-num bold">0</td>
                </tr>
                <tr>
                    <td class="role-name bold">Campus Director</td>
                    <td class="total-num bold">1</td>
                    <td class="active-num bold">1</td>
                    <td class="inactive-num bold">0</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

