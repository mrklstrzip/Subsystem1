@{
    ViewBag.Title = "Faculty Profile";
}

<link href="@Url.Content("~/Content/css/facultyprofile.css")?v=3.0" rel="stylesheet" type="text/css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<!-- Header Banner -->
<div class="dashboard-header">
    <div class="header-text">
        <span class="breadcrumb-text">Admin / Faculty Profile</span>
        <h1 class="page-title">Faculty Profile</h1>
        <p class="welcome-text">Manage faculty expertise data</p>
    </div>
    <div class="header-bg-icon">
        <i class="fa fa-user-pen"></i>
    </div>
</div>

<!-- Controls Container Card -->
<div class="controls-card">
    <div class="search-container">
        <div class="search">
            <i class="fa fa-search"></i>
            <input type="text" id="searchInput" placeholder="Search faculty name or expertise tags">
        </div>
    </div>
</div>

<!-- Faculty Profile Table Section -->
<div class="expertise-tag-management">
    <table class="expertise-tag-management-table" id="facultyTable">
        <thead>
            <tr>
                <th class="column-title name-col">NAME</th>
                <th class="column-title tags-col">EXPERTISE TAG</th>
                <th class="column-title action-col">ACTION</th>
            </tr>
        </thead>
        <tbody id="faculty-tbody"></tbody>
    </table>
</div>

<!-- Edit Faculty Profile Modal -->
<div id="editFacultyModal" class="modal-overlay">
    <div class="modal-card">
        <h3 class="modal-title">EDIT FACULTY EXPERTISE</h3>
        <form onsubmit="AD.saveExpertise(); return false;">
            <!-- Readonly Name Input -->
            <div class="form-group">
                <label>Name</label>
                <input type="text" id="facultyName" class="readonly-field" readonly>
            </div>

            <!-- Editable Selected Tags Area -->
            <div class="form-group" style="margin-top: 12px;">
                <label>Expertise Tag</label>
                <div class="selected-tags-box" id="selectedTagsBox"></div>
            </div>

            <!-- Available Tags Grid -->
            <div class="tags-grid-box" id="systemTagsGrid" style="margin-top: 12px;"></div>

            <div class="modal-actions" style="margin-top: 16px;">
                <button type="submit" class="btn-confirm">Confirm</button>
                <button type="button" class="btn-cancel" onclick="AD.closeModals()">Cancel</button>
            </div>
        </form>
    </div>
</div>

<script src="@Url.Content("~/Scripts/admin-app.js")?v=3.0"></script>