@{
    Layout = null;
    ViewBag.Title = "Login";
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Quezon City University</title>
    <link href="@Url.Content("~/Content/css/auth.css")?v=1.0" rel="stylesheet" type="text/css" />
    <link href="@Url.Content("~/Content/fontawesome/css/all.min.css")?v=1.0" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600&display=swap" rel="stylesheet">
</head>
<body class="login-body user-theme">
    <header class="login-header">

        <div class="logo-bg">
            <img src="@Url.Content("~/Content/images/qcu.jpeg")" alt="QCU Logo" class="header-logo" />
            <img src="@Url.Content("~/Content/images/ccs-logo.png")" alt="CCS Logo" class="header-logo" />
        </div>

        <div class="header-text">
            <h1>Quezon City University</h1>
            <span>College of Computer Studies</span>
        </div>

        <div class="header-stripes">
            <span class="stripe stripe-1"></span>
            <span class="stripe stripe-2"></span>
            <span class="stripe stripe-3"></span>
        </div>

    </header>


    <main class="main-container">

        <svg class="bg-wave"
             viewBox="0 0 1440 900"
             preserveAspectRatio="none">

            <path d="M-100,0 C350,250 350,650 750,450 C1150,250 1200,850 1600,1000 L1600,0 Z" />

        </svg>


        <div class="watermark-container">

            <div class="watermark-rings">

                <img src="@Url.Content("~/Content/images/ccs-logo.png")" alt="CCS Watermark" class="ccs-watermark" />

            </div>

        </div>


        <div class="login-card">

            <img src="@Url.Content("~/Content/images/qcu.jpeg")" alt="QCU Logo" class="card-logo" />

            <h2 class="card-title">Login</h2>


            <form id="loginForm" action="" method="post" class="login-form">


                <fieldset class="input-fieldset">

                    <legend>Email</legend>

                    <div class="input-field-wrapper">

                        <i class="fas fa-envelope input-icon"></i>
                        <input type="email" id="Email" name="Email" placeholder="" required />

                    </div>
                </fieldset>


                <fieldset class="input-fieldset">
                    <legend>Password</legend>
                    <div class="input-field-wrapper">
                        <i class="fas fa-lock input-icon"></i>
                        <input type="password" id="Password" name="Password" placeholder="" required />
                    </div>
                </fieldset>


                <button type="submit"
                        class="btn-login">
                    Login
                </button>


                <p>
                    Are you a Project Manager?
                    <a href="@Url.Action("request", "Request", new { area = "Auth" })">Request an Account</a>
                </p>

            </form>

        </div>

    </main>


    <script src="@Url.Content("~/Scripts/dummy-users.js")?v=1.1"></script>
    <script src="@Url.Content("~/Scripts/admin-shortcut.js")?v=1.2"></script>
    <script src="@Url.Content("~/Scripts/login-check.js")?v=1.1"></script>
</body>
</html>
