@{
    ViewBag.Title = "Dashboard";
}

<div class="pf-page">

    <div class="pf-banner">
        <div>
            <div class="pf-eyebrow">@DateTime.Now.ToString("dddd, MMMM d")</div>
            <h1>Welcome back, Dizon</h1>
            <p>5 Panel Assignments are waiting for your decision.</p>
        </div>
        <svg class="pf-banner-deco" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" /><rect x="14" y="3" width="7" height="7" /><rect x="3" y="14" width="7" height="7" /><rect x="14" y="14" width="7" height="7" /></svg>
    </div>

    <!-- Stats -->
    <div class="pf-stats">
        <div class="pf-stat">
            <div class="pf-stat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="9" cy="8" r="3.5" /><path d="M2 20c0-3.5 3-6 7-6" /><circle cx="17" cy="17" r="4" /><path d="M17 15v2l1.5 1" /></svg></div>
            <div><div class="pf-stat-num">6</div><div class="pf-stat-label">Pending Review</div></div>
        </div>
        <div class="pf-stat">
            <div class="pf-stat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><path d="M8 12l3 3 5-6" /></svg></div>
            <div><div class="pf-stat-num">6</div><div class="pf-stat-label">Accepted Panels</div></div>
        </div>
        <div class="pf-stat">
            <div class="pf-stat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 21V4h12l-2 4 2 4H5" /></svg></div>
            <div><div class="pf-stat-num">6</div><div class="pf-stat-label">Completed<br />Assignments</div></div>
        </div>
        <div class="pf-stat">
            <div class="pf-stat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M3 10h18M8 3v4M16 3v4" /><circle cx="16" cy="16" r="3" /></svg></div>
            <div><div class="pf-stat-num">6</div><div class="pf-stat-label">Upcoming Defenses</div></div>
        </div>
    </div>

    <!-- Pending list + Next defense -->
    <div class="pf-dash-grid">
        <div class="pf-panel">
            <div class="pf-panel-head">
                <h3>Pending Panel Assignments</h3>
                <a href="#">View All</a>
            </div>
            <table class="pf-table">
                <thead>
                    <tr>
                        <th>Manuscript</th>
                        <th class="c">Program</th>
                        <th class="c">Date</th>
                        <th class="c">Action</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Manuscript Title<small>4th Year</small></td>
                        <td class="c"><span class="pf-badge pf-badge-bsit">BSIT</span></td>
                        <td class="c">Oct 10</td>
                        <td class="c"><a href="#" class="pf-btn pf-btn-outline">View</a></td>
                    </tr>
                    <tr>
                        <td>Manuscript Title<small>4th Year</small></td>
                        <td class="c"><span class="pf-badge pf-badge-bscs">BSCS</span></td>
                        <td class="c">Oct 10</td>
                        <td class="c"><a href="#" class="pf-btn pf-btn-outline">View</a></td>
                    </tr>
                    <tr>
                        <td>Manuscript Title<small>4th Year</small></td>
                        <td class="c"><span class="pf-badge pf-badge-bsis">BSIS</span></td>
                        <td class="c">Oct 10</td>
                        <td class="c"><a href="#" class="pf-btn pf-btn-outline">View</a></td>
                    </tr>
                    <tr>
                        <td>Manuscript Title<small>4th Year</small></td>
                        <td class="c"><span class="pf-badge pf-badge-bsit">BSIT</span></td>
                        <td class="c">Oct 10</td>
                        <td class="c"><a href="#" class="pf-btn pf-btn-outline">View</a></td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="pf-next">
            <div class="pf-eyebrow">Next Defense</div>
            <h4>Date: October 14</h4>
            <h4>Time: 10:30</h4>
            <p style="margin-top:8px">Section: SBIT4E</p>
            <p>Building/Room: IK603</p>
            <a href="#" class="pf-btn">View Schedule</a>
        </div>
    </div>

</div>