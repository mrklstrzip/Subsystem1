@using System.Linq
@using Subsystem1.Areas.Student.ViewModels
@model Subsystem1.Areas.Student.ViewModels.StudentStatusViewModel
@{
    ViewBag.Title = "Status";
    bool hasManuscript = !string.IsNullOrEmpty(Model.ManuscriptTitle);
    string message = TempData["StatusMessage"] as string;
}

<link href="@Url.Content("~/Content/css/student-status.css")?v=1.0" rel="stylesheet" type="text/css" />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,200..800;1,6..72,200..800&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap" rel="stylesheet">



<h1>Status</h1>

@if (!string.IsNullOrEmpty(message))
{
    <div class="st-message" role="status">@message</div>
}

<section class="st-tracker" aria-label="Manuscript progress">
    <ol class="st-steps">
        @for (int i = 1; i <= Model.TotalStages; i++)
        {
            string state = i < Model.Stage ? "done" : (i == Model.Stage ? "current" : "todo");
            string label = Model.StageLabels[i - 1];
            bool locked = i > Model.Stage;
            bool isAction = i == Model.Stage && Model.AwaitingDefenseConfirmation;

            <li class="st-step">
                @if (i > 1)
                {
                    <span class="st-link st-link-s@(i - 1)" data-step="@i" aria-hidden="true"></span>
                }
                <div class="st-nodewrap">
                    <button type="button"
                            class="st-node st-node-@state st-node-s@(i) @(locked ? "st-node-locked" : "") @(isAction ? "st-node-action" : "")"
                            data-step="@i"
                            aria-pressed="false"
                            aria-disabled="@(locked ? "true" : "false")"
                            title="@(locked ? label + " (not reached yet)" : state == "current" && !isAction ? label + " (processing)" : label)">
                        <span class="st-sr">Step @i: @label</span>
                    </button>

                    @if (isAction)
                    {
                        using (Html.BeginForm("confirmdefense", "Status", new { area = "Student" }, FormMethod.Post, new { @class = "st-confirm" }))
                        {
                            @Html.AntiForgeryToken()
                            <p>Is your defense completed?</p>
                            <div class="st-confirm-actions">
                                <button type="submit" name="completed" value="true" class="st-btn st-btn-yes">Completed</button>
                                <button type="submit" name="completed" value="false" class="st-btn st-btn-no">Not yet</button>
                            </div>
                        }
                    }
                </div>
            </li>
        }
    </ol>
</section>

<ul class="st-legend" aria-label="Legend">
    <li><span class="st-dot st-dot-done"></span>Completed</li>
    <li><span class="st-dot st-dot-processing"></span>Processing</li>
    <li><span class="st-dot st-dot-off"></span>Not yet</li>
</ul>

<section class="st-card" aria-label="Manuscript details">
    <div class="st-grid">
        <div class="st-col st-col-title">
            <div class="st-head">Manuscript</div>
            <div class="st-cell">
                @if (hasManuscript)
                {
                    var parts = Model.ManuscriptTitle.Split(new[] { ':' }, 2);
                    if (parts.Length == 2)
                    {
                        <strong>@parts[0]:</strong>@parts[1]
                    }
                    else
                    {
                        <strong>@Model.ManuscriptTitle</strong>
                    }
                }
                else
                {
                    <span class="st-muted">No submission yet</span>
                }
            </div>
        </div>

        <div class="st-col st-col-panel">
            <div class="st-head">Panelists</div>
            <div class="st-cell st-cell-strong">
                @if (Model.Panelists.Any())
                {
                    <text>@string.Join(", ", Model.Panelists)</text>
                }
                else
                {
                    <span class="st-muted">Not assigned yet</span>
                }
            </div>
        </div>

        <div class="st-col st-col-room">
            <div class="st-head">Room</div>
            <div class="st-cell st-cell-strong">
                @(string.IsNullOrEmpty(Model.Room) ? "TBA" : Model.Room)
            </div>
        </div>

        <div class="st-col st-col-date">
            <div class="st-head">Date</div>
            <div class="st-cell st-cell-strong">
                @(Model.DefenseDate.HasValue ? Model.DefenseDate.Value.ToString("MM-dd-yyyy") : "TBA")
            </div>
        </div>
    </div>
</section>

<section class="st-card st-log" aria-label="Activity">
    <div class="st-log-row st-log-head">
        <span>Time</span>
        <span>Activity</span>
        <span>Date</span>
    </div>

    @if (Model.Activity.Any())
    {
        foreach (var a in Model.Activity.OrderBy(x => x.Date))
        {
            <div class="st-log-row">
                <span>@a.Date.ToString("h:mm tt")</span>
                <span class="st-log-text">@a.Description</span>
                <span class="st-log-date">@a.Date.ToString("MM-dd-yyyy")</span>
            </div>
        }
    }
    else
    {
        <div class="st-empty">No activity yet</div>
    }
</section>

<script>
(function () {
    var nodes = Array.prototype.slice.call(document.querySelectorAll('.st-node'));
    var links = Array.prototype.slice.call(document.querySelectorAll('.st-link'));
    var actionNode = document.querySelector('.st-node-action');
    var current = @Model.Stage;
    var reached = 0;
    var started = false;

    function render() {
        nodes.forEach(function (n) {
            var step = parseInt(n.getAttribute('data-step'), 10);
            n.classList.remove('st-done', 'st-processing');
            if (started && step <= reached) {
                n.classList.add('st-done');
            } else if (started && step === reached + 1 && step <= current) {
                n.classList.add('st-processing');
            }
            n.setAttribute('aria-pressed', (started && step <= reached) ? 'true' : 'false');
        });
        links.forEach(function (l) {
            var step = parseInt(l.getAttribute('data-step'), 10);
            l.classList.remove('st-link-on', 'st-link-proc');
            if (started && step <= reached) {
                l.classList.add('st-link-on');
            } else if (started && step === reached + 1 && step <= current) {
                l.classList.add('st-link-proc');
            }
        });
    }

    function togglePopup(open) {
        if (actionNode) actionNode.classList.toggle('st-open', open);
    }

    nodes.forEach(function (n) {
        n.addEventListener('click', function () {
            var step = parseInt(n.getAttribute('data-step'), 10);
            if (step > current) return;

            started = true;

            if (step === current) {
                reached = current - 1;
                render();
                if (n === actionNode) togglePopup(!n.classList.contains('st-open'));
                else togglePopup(false);
                return;
            }

            reached = (step === reached) ? step - 1 : step;
            render();
            togglePopup(false);
        });
    });

    document.addEventListener('click', function (e) {
        if (actionNode && !e.target.closest('.st-nodewrap')) togglePopup(false);
    });
    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') togglePopup(false);
    });

    render();
})();
</script>