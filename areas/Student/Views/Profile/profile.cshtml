
@{
    ViewBag.Title = "Profile";
}

<link href="@Url.Content("~/Content/css/profile.css")?v=1.1"
      rel="stylesheet"
      type="text/css" />

<div class="pm role-student">
    <section class="pm-banner">
        <div>
            <small>Project Manager | Profile</small>
            <h1>Profile</h1>
            <p>Manage account credentials</p>
        </div>
        <i class="fa fa-circle-user pm-banner-icon"></i>
    </section>

    <div class="pm-profile-grid">

        <!-- PROFILE INFORMATION -->
        <section class="pm-card">
            <h2 class="pm-card-title">Profile Information</h2>

            <div class="pm-profile-head">
                <img id="pmPhoto"
                     class="pm-avatar pm-avatar--lg"
                     src="@Url.Content("~/Content/images/student-avatar.png")"
                     alt="Student profile picture" />

                <div>
                    <strong id="pmHeadName" class="pm-profile-name"></strong>
                    <span id="pmHeadRole" class="pm-profile-role"></span>
                </div>
            </div>

            <table class="pm-info-table">
                <tbody id="profileTableBody">
                    <tr>
                        <td class="label">NAME</td>
                        <td class="info" id="infoName"></td>
                    </tr>
                    <tr>
                        <td class="label">ID</td>
                        <td class="info" id="infoNumber"></td>
                    </tr>
                    <tr>
                        <td class="label">ROLE</td>
                        <td class="info" id="infoRole"></td>
                    </tr>
                    <tr>
                        <td class="label">EMAIL</td>
                        <td class="info" id="infoEmail"></td>
                    </tr>
                </tbody>
            </table>
        </section>

        <!-- CHANGE PASSWORD -->
        <section class="pm-card">
            <h2 class="pm-card-title">Change Password</h2>

            <form class="pm-pw-form"
                  id="changePasswordForm"
                  onsubmit="return false;">

                <label for="current-password">
                    Current password
                    <span class="pm-input">
                        <input type="password"
                               id="current-password"
                               required />
                        <i class="fa fa-eye toggle-password"></i>
                    </span>
                </label>

                <label for="new-password">
                    New password
                    <span class="pm-input">
                        <input type="password"
                               id="new-password"
                               required />
                        <i class="fa fa-eye toggle-password"></i>
                    </span>
                </label>

                <label for="confirm-password">
                    Confirm password
                    <span class="pm-input">
                        <input type="password"
                               id="confirm-password"
                               required />
                        <i class="fa fa-eye toggle-password"></i>
                    </span>
                </label>

                <div class="pm-pw-actions">
                    <button type="submit" class="pm-primary">
                        Confirm
                    </button>
                </div>
            </form>
        </section>

    </div>
</div>

<script src="@Url.Content("~/Scripts/student-profile.js")?v=1.0"></script>
