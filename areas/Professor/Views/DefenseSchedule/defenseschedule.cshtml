@{
    ViewBag.Title = "Defense Schedule";
}

<link href="@Url.Content("~/Content/fontawesome/css/all.min.css")?v=1.0" rel="stylesheet" />

<div class="pf-page">

    <input type="radio" name="dsTab" id="dsAll" class="pf-radio pf-r1" checked />
    <input type="radio" name="dsTab" id="dsUpcoming" class="pf-radio pf-r2" />
    <input type="radio" name="dsTab" id="dsCompleted" class="pf-radio pf-r3" />

    <div class="dashboard-header">
        <div class="header-text">
            <span class="breadcrumb-text">Panelist | Defense Schedule</span>
            <h1 class="page-title">Defense Schedule</h1>
            <p class="welcome-text">
                Every defense you are part of, in date order.
            </p>
        </div>

        <a href="#" class="pf-banner-btn">
            Go to Post Defense
        </a>

        <div class="header-bg-icon">
            <i class="fa fa-calendar"></i>
        </div>
    </div>

    <!-- Tabs -->
    <div class="pf-tabs">
        <label for="dsAll" class="pf-tab pf-t1">All <span class="pf-count">3</span></label>
        <label for="dsUpcoming" class="pf-tab pf-t2">Upcoming <span class="pf-count">2</span></label>
        <label for="dsCompleted" class="pf-tab pf-t3">Completed <span class="pf-count">1</span></label>
    </div>

    <div class="pf-ds-grid">

        <div>

            <!-- October 6, 2026 (only upcoming defenses) -->
            <div class="pf-g-up">
                <div class="pf-ds-date">October 6, 2026</div>

                <div class="pf-ds-row pf-up">
                    <div class="pf-ds-time">10:30 PM<small>02:30 PM</small></div>
                    <div class="pf-ds-card">
                        <div>
                            <h4>Manuscript Title</h4>
                            <small><span>Group No.</span><span>Program</span><span>Section</span></small>
                        </div>
                        <div class="pf-ds-right">
                            <div class="pf-ds-room"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s7-6.5 7-12a7 7 0 10-14 0c0 5.5 7 12 7 12z" /><circle cx="12" cy="10" r="2.5" /></svg>IK602</div>
                            <span class="pf-pill upcoming">Upcoming</span>
                        </div>
                    </div>
                </div>

                <div class="pf-ds-row pf-up">
                    <div class="pf-ds-time">5:30 PM<small>02:30 PM</small></div>
                    <div class="pf-ds-card">
                        <div>
                            <h4>Manuscript Title</h4>
                            <small><span>Group No.</span><span>Program</span><span>Section</span></small>
                        </div>
                        <div class="pf-ds-right">
                            <div class="pf-ds-room"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s7-6.5 7-12a7 7 0 10-14 0c0 5.5 7 12 7 12z" /><circle cx="12" cy="10" r="2.5" /></svg>IK602</div>
                            <span class="pf-pill upcoming">Upcoming</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- October 3, 2026 (only completed defenses) -->
            <div class="pf-g-done">
                <div class="pf-ds-date">October 3, 2026</div>

                <div class="pf-ds-row pf-done">
                    <div class="pf-ds-time">8:00 AM<small>10:30 AM</small></div>
                    <div class="pf-ds-card">
                        <div>
                            <h4>Manuscript Title</h4>
                            <small><span>Group No.</span><span>Program</span><span>Section</span></small>
                        </div>
                        <div class="pf-ds-right">
                            <div class="pf-ds-room"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s7-6.5 7-12a7 7 0 10-14 0c0 5.5 7 12 7 12z" /><circle cx="12" cy="10" r="2.5" /></svg>IK602</div>
                            <span class="pf-pill completed">Completed</span>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <div class="pf-next">
            <div class="pf-eyebrow">Next Defense</div>
            <h4>Date: October 14</h4>
            <h4>Time: 10:30 - 2:30</h4>
            <p style="margin-top:8px">Section: SBIT4E</p>
            <p>Building/Room: IK603</p>
        </div>

    </div>
</div>