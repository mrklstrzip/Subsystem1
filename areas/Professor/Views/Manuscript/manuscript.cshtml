@{
    ViewBag.Title = "Manuscripts Details";
}

<link href="@Url.Content("~/Content/fontawesome/css/all.min.css")?v=1.0" rel="stylesheet" />


<div class="pf-page">
    <div class="dashboard-header">
        <div class="header-text">
            <span class="breadcrumb-text">Panelist | Manuscripts Details</span>
            <h1 class="page-title">Manuscripts Details</h1>
            <p class="welcome-text">View manuscript details from your groups</p>
        </div>
        <div class="header-bg-icon">
            <i class="fa fa-th-large"></i>
        </div>
    </div>

    <div class="pf-filters">
        <div class="pf-filter">
            <label for="msSearch">Search</label>
            <input type="text" id="msSearch" placeholder="Search title or group" />
        </div>
        <div class="pf-filter">
            <label for="msSection">Section</label>
            <select id="msSection">
                <option value="">Select Section</option>
                <option>SBIT-4A</option>
                <option>SBIT-4E</option>
                <option>SBCS-4A</option>
                <option>SBIS-4B</option>
            </select>
        </div>
    </div>

    <div class="pf-ms-grid" id="msGrid">

        <div class="pf-ms-card" data-title="Manuscript Title" data-group="Group 5" data-section="SBIT-4E">
            <div class="pf-ms-thumb"><div class="pf-ms-doc"><i></i><i></i><i></i><i></i><i></i></div></div>
            <div class="pf-ms-info">
                <b>Manuscript Title</b>
                <small><span>Group 5</span><span>SBIT-4E</span></small>
                <a href="#" class="pf-btn pf-btn-outline">View Manuscript Details</a>
            </div>
        </div>

        <div class="pf-ms-card" data-title="Manuscript Title" data-group="Group 5" data-section="SBIS-4B">
            <div class="pf-ms-thumb"><div class="pf-ms-doc"><i></i><i></i><i></i><i></i><i></i></div></div>
            <div class="pf-ms-info">
                <b>Manuscript Title</b>
                <small><span>Group 5</span><span>SBIS-4B</span></small>
                <a href="#" class="pf-btn pf-btn-outline">View Manuscript Details</a>
            </div>
        </div>

    </div>
</div>
