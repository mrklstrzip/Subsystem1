@using System.Linq
@using System.Collections.Generic
@using Subsystem1.Areas.Admin.Controllers
@using Subsystem1.Data
@model List<AdminRequestItem>
@{
    var waiting = Model.Where(i => !i.Created).ToList();
    var done = Model.Where(i => i.Created).ToList();
}
@helper Item(AdminRequestItem i)
{
    <div class="notif-item @(i.Created ? "" : "unread")" data-id="req:@i.Id">
        <div class="notif-icon"><i class="fa fa-user"></i></div>
        <div class="notif-content">
            <div class="notif-item-title">@i.Name request an account @if (!i.Created) {<span class="unread-dot"></span>}</div>
            <p>@(string.IsNullOrEmpty(i.ProgramName) ? "Student" : i.ProgramName + " student")@(string.IsNullOrEmpty(i.AdviserName) ? "" : " under Adviser " + i.AdviserName)</p>
            <div class="notif-actions">
                @if (i.Created)
                {
                    <span class="notif-time">Created</span>
                }
                else
                {
                    <button type="button" class="btn-approve" data-action="create" data-request="@i.Id">Create</button>
                    <span class="notif-time">@DisplayFormat.TimeAgo(i.At)</span>
                }
            </div>
        </div>
    </div>
}
@if (Model.Count == 0)
{
    <p style="padding:24px 20px; color:#6b7280; font-size:13px; text-align:center;">No account requests yet. Requests that an Adviser sends to you show up here.</p>
}
@if (waiting.Count > 0)
{
    <div class="notif-group-label">WAITING FOR AN ACCOUNT</div>
    foreach (var i in waiting) { @Item(i) }
}
@if (done.Count > 0)
{
    <div class="notif-group-label">EARLIER</div>
    foreach (var i in done) { @Item(i) }
}
