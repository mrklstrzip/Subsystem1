<div id="saConfig"
     data-details-url="@Url.Action("scheduleDetails", "AdminApi")"
     data-manuscript-url="@Url.Action("scheduleManuscript", "AdminApi")"
     hidden></div>

<!-- Pop-up -->
<div class="sa-overlay" id="saOverlay" aria-hidden="true">
    <div class="sa-modal" role="dialog" aria-modal="true" aria-labelledby="saModalTitle">
        <div class="sa-modal-head">
            <div>
                <h2 id="saModalTitle">Submitted Schedule</h2>
                <p>College of Computer Studies - QCU &nbsp;·&nbsp; Defense Schedule</p>
            </div>
            <button type="button" class="sa-x" id="saX" aria-label="Close"><i class="fa fa-xmark"></i></button>
        </div>

        <div class="sa-info">
            <div><label>PROJECT TITLE</label><strong id="mTitle"></strong></div>
            <div><label>DATE SUBMITTED</label><strong id="mSubmitted"></strong></div>
            <div><label>CURRENT STATUS</label><span class="sa-status" id="mStatus"></span></div>
            <div class="sa-info-sep"></div>
            <div><label>PROJECT MANAGER</label><strong id="mStudent"></strong></div>
            <div><label>PROGRAM</label><strong id="mProgram"></strong></div>
            <div><label>ADVISER</label><strong id="mAdviser"></strong></div>
        </div>

        <div class="sa-body">
            <div class="sa-panel sa-manuscript-panel">
                <div class="sa-manuscript-head">
                    <h3>Manuscript</h3>
                    <a id="mManuscriptOpen" class="sa-manuscript-open" target="_blank" rel="noopener" hidden>Open PDF</a>
                </div>
                <div class="sa-pdf-viewer" aria-label="Manuscript PDF viewer">
                    <div class="sa-pdf-toolbar">
                        <button type="button" id="saPdfPrev" aria-label="Previous page">‹</button>
                        <span><span id="saPdfPage">—</span> / <span id="saPdfPages">—</span></span>
                        <button type="button" id="saPdfNext" aria-label="Next page">›</button>
                        <button type="button" id="saPdfZoomOut" aria-label="Zoom out">−</button>
                        <button type="button" id="saPdfZoomIn" aria-label="Zoom in">+</button>
                    </div>
                    <div class="sa-pdf-canvas-wrap" id="saPdfCanvasWrap">
                        <canvas id="saPdfCanvas" hidden></canvas>
                        <p id="saPdfMessage" class="sa-pdf-message">No PDF manuscript is available for this submission.</p>
                    </div>
                </div>
                <small class="sa-muted" id="mSubmittedSmall"></small>
            </div>

            <div class="sa-panel">
                <h3>Assigned Panelists</h3>
                <div class="sa-panel-row sa-panel-row-head"><span>Panelists</span><span>Expertise Match</span></div>
                <div id="mPanelists"></div>

                <h3 class="sa-mt">Proposed Defense Schedule</h3>
                <dl class="sa-sched">
                    <dt>TIME</dt>
                    <dd id="mTime"></dd>
                    <dt>DATE</dt>
                    <dd id="mDate"></dd>
                    <dt>BUILDING</dt>
                    <dd id="mBuilding">-</dd>
                    <dt>ROOM</dt>
                    <dd id="mRoom"></dd>
                </dl>
            </div>
        </div>

        <div class="sa-modal-foot">
            <button type="button" class="sa-btn-close" id="saClose">CLOSE</button>
        </div>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
