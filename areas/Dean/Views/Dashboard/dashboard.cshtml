@model Subsystem1.Areas.Dean.Models.DashboardViewModel
@{
    ViewBag.Title = "Dashboard";
}

<div class="dashboard-header">
    <div class="header-text">
        <h1 class="page-title">Dashboard</h1>
        <p class="welcome-text">Review submitted defense schedules, upcoming defenses and recent activity</p>
    </div>
    <div class="header-bg-icon">
        <i class="fa fa-calendar-check"></i>
    </div>
</div>

<div class="dash-grid">
    <div class="dash-main">

        <div class="dash-card">
            <div class="dash-card-head">
                <h2>Subsystem 3 Repository</h2>
                <a href="@Url.Action("Index", "Repository", new { area = "Dean" })" class="view-all">Open Repository</a>
            </div>
            <p class="welcome-text">@Model.ClearedManuscripts cleared or filed manuscripts are available for Dean review.</p>
        </div>

        <div class="dash-card">
            <div class="dash-card-head">
                <h2>To Approve</h2>
                <a href="@Url.Action("ScheduleApprovalView", "ScheduleApproval")" class="view-all">View All</a>
            </div>
            <table class="dash-table to-approve-table">
                <thead>
                    <tr><th class="left">MANUSCRIPT</th><th>PROJECT MANAGER</th><th>ADVISER</th><th>ROOM</th><th>DATE</th><th>TIME</th></tr>
                </thead>
                <tbody>
                    @if (!Model.ToApprove.Any())
                    {
                        <tr><td colspan="6">Nothing is waiting for your approval.</td></tr>
                    }
                    @foreach (var r in Model.ToApprove)
                    {
                        <tr class="dashboard-clickable-row" data-sa-open data-id="@r.Id" tabindex="0" role="button" aria-label="Open schedule for @r.Title">
                            <td class="left">
                                <div class="ms-title">@r.Title</div>
                                <span class="tag @r.TagClass">@r.Section</span>
                            </td>
                            <td>@r.Author</td>
                            <td>@r.Adviser</td>
                            <td><strong>@(String.IsNullOrWhiteSpace(r.Room) ? "-" : r.Room)</strong></td>
                            <td>@r.Date</td>
                            <td>@r.Time</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="dash-card">
            <div class="dash-card-head">
                <h2>Upcoming Defenses</h2>
                <a href="@Url.Action("DefenseScheduleView", "DefenseSchedule")" class="view-all">View All</a>
            </div>
            <table class="dash-table upcoming-defenses-table">
                <thead>
                    <tr><th class="left">MANUSCRIPT</th><th>PROJECT MANAGER</th><th>ADVISER</th><th>ROOM</th><th>DATE</th><th>TIME</th></tr>
                </thead>
                <tbody>
                    @if (!Model.Upcoming.Any())
                    {
                        <tr><td colspan="6">No upcoming defenses yet.</td></tr>
                    }
                    @foreach (var r in Model.Upcoming)
                    {
                        <tr>
                            <td class="left">
                                <div class="ms-title">@r.Title</div>
                                <span class="tag @r.TagClass">@r.Section</span>
                            </td>
                            <td>@r.Author</td>
                            <td>@r.Adviser</td>
                            <td><strong>@r.Room</strong></td>
                            <td>@r.Date</td>
                            <td>@r.Time</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <aside class="dash-side">
        <a class="dash-card stat-card dashboard-stat-link" href="@Url.Action("DefenseScheduleView", "DefenseSchedule")" aria-label="View defense schedules">
            <div>
                <div class="stat-label">TOTAL DEFENSES</div>
                <div class="stat-number">@Model.TotalDefenses</div>
                <div class="stat-sub">Approved defense schedules</div>
            </div>
            <i class="fa fa-door-open stat-icon"></i>
        </a>

        <div class="dash-card">
            <div class="dash-card-head"><h2 class="muted-h">RECENT ACTIVITIES</h2></div>
            <table class="dash-table activity-table">
                <thead><tr><th class="left">TIME</th><th class="left">ACTIVITY</th></tr></thead>
                <tbody>
                    @foreach (var a in Model.RecentActivities)
                    {
                        <tr><td class="left">@a.Time</td><td class="left">@a.Text</td></tr>
                    }
                    @for (var i = Model.RecentActivities.Count; i < 4; i++)
                    {
                        <tr><td>&nbsp;</td><td></td></tr>
                    }
                </tbody>
            </table>
        </div>
    </aside>
</div>

@Html.Partial("_ScheduleApprovalModal")
<script src="@Url.Content("~/Scripts/DeanSchedApproval.js")?v=1.4"></script>
<script>
    document.addEventListener("keydown", function (event) {
        var row = event.target.closest ? event.target.closest("tr.dashboard-clickable-row[data-sa-open]") : null;
        if (row && (event.key === "Enter" || event.key === " ")) {
            event.preventDefault();
            row.click();
        }
    });
</script>
