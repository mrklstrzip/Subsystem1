@{
    ViewBag.Title = "_ScheduleApprovalModal";
}

@Html.AntiForgeryToken()

<div id="saConfig"
     data-details-url="@Url.Action("Details", "ScheduleApproval")"
     data-approve-url="@Url.Action("Approve", "ScheduleApproval")"
     hidden></div>

<!-- Pop-up -->
<div class="sa-overlay" id="saOverlay" aria-hidden="true">
    <div class="sa-modal" role="dialog" aria-modal="true" aria-labelledby="saModalTitle">
        <div class="sa-modal-head">
            <div>
                <h2 id="saModalTitle">Submitted Schedule</h2>
                <p>College of Computer Studies - QCU &nbsp;·&nbsp; Defense Schedule</p>
            </div>
            <button type="button" class="sa-x" id="saX" aria-label="Close"><i class="fa fa-xmark"></i></button>
        </div>

        <div class="sa-info">
            <div><label>PROJECT TITLE</label><strong id="mTitle"></strong></div>
            <div><label>DATE SUBMITTED</label><strong id="mSubmitted"></strong></div>
            <div><label>CURRENT STATUS</label><span class="sa-status" id="mStatus"></span></div>
            <div class="sa-info-sep"></div>
            <div><label>PROJECT MANAGER</label><strong id="mStudent"></strong></div>
            <div><label>PROGRAM</label><strong id="mProgram"></strong></div>
            <div><label>ADVISER</label><strong id="mAdviser"></strong></div>
        </div>

        <div class="sa-body">
            <div class="sa-panel">
                <h3>Abstract</h3>
                <p id="mAbstract"></p>
                <h3>Keywords</h3>
                <p id="mKeywords"></p>
                <small class="sa-muted" id="mSubmittedSmall"></small>
            </div>

            <div class="sa-panel">
                <h3>Assigned Panelists</h3>
                <div class="sa-panel-row sa-panel-row-head"><span>Panelists</span><span>Expertise Match</span></div>
                <div id="mPanelists"></div>

                <h3 class="sa-mt">Proposed Defense Schedule</h3>
                <dl class="sa-sched">
                    <dt>TIME</dt>
                    <dd id="mTime"></dd>
                    <dt>DATE</dt>
                    <dd id="mDate"></dd>
                    <dt>BUILDING</dt>
                    <dd id="mBuilding">-</dd>
                    <dt>ROOM</dt>
                    <dd id="mRoom"></dd>
                </dl>
            </div>
        </div>

        <div class="sa-modal-foot">
            <button type="button" class="sa-btn-close" id="saClose">CLOSE</button>
            <button type="button" class="sa-btn-reject" id="saReject">REJECT</button>
            <button type="button" class="sa-btn-approve" id="saApprove">APPROVE</button>
        </div>
    </div>
</div>

<!-- Reject reason pop-up (frontend only) -->
<div class="sa-overlay" id="saRejectOverlay" aria-hidden="true">
    <div class="sa-reject-modal" role="dialog" aria-modal="true" aria-labelledby="saRejectTitle">
        <h3 id="saRejectTitle">Reject Schedule</h3>
        <p>Please state the reason for rejecting this schedule.</p>
        <textarea id="saRejectReason" maxlength="500" placeholder="Type the reason here..."></textarea>
        <p class="sa-reject-error" id="saRejectError" hidden>Please enter a reason.</p>
        <div class="sa-modal-foot">
            <button type="button" class="sa-btn-close" id="saRejectCancel">CANCEL</button>
            <button type="button" class="sa-btn-reject sa-btn-reject-solid" id="saRejectConfirm">REJECT</button>
        </div>
    </div>
</div>



<script>
    //for testing lang ng frontend para makita itsura (pa remove nalang pag aayusin backend)
    (function () {
        var panelists = document.getElementById("mPanelists");
        var defaultPercent = { high: 90, medium: 70, low: 40 };

        function addPercents() {
            var pills = panelists.querySelectorAll(".sa-match");
            for (var i = 0; i < pills.length; i++) {
                var pill = pills[i];
                if (pill.parentNode.classList.contains("sa-match-wrap")) continue;

                var level = pill.classList.contains("match-high") ? "high"
                    : pill.classList.contains("match-medium") ? "medium" : "low";

                var pct = document.createElement("span");
                pct.className = "sa-match-pct";
                pct.textContent = (pill.getAttribute("data-percent") || defaultPercent[level]) + "%";

                var wrap = document.createElement("span");
                wrap.className = "sa-match-wrap";
                pill.parentNode.insertBefore(wrap, pill);
                wrap.appendChild(pct);
                wrap.appendChild(pill);
            }
        }
        new MutationObserver(addPercents).observe(panelists, { childList: true, subtree: true });
        addPercents();

        var overlay = document.getElementById("saOverlay");
        var rejectOverlay = document.getElementById("saRejectOverlay");
        var reason = document.getElementById("saRejectReason");
        var error = document.getElementById("saRejectError");

        function openReject() {
            reason.value = "";
            error.hidden = true;
            rejectOverlay.classList.add("open");
            rejectOverlay.setAttribute("aria-hidden", "false");
            reason.focus();
        }
        function closeReject() {
            rejectOverlay.classList.remove("open");
            rejectOverlay.setAttribute("aria-hidden", "true");
        }

        document.getElementById("saReject").addEventListener("click", openReject);
        document.getElementById("saRejectCancel").addEventListener("click", closeReject);
        rejectOverlay.addEventListener("click", function (e) {
            if (e.target === rejectOverlay) closeReject();
        });

        document.getElementById("saRejectConfirm").addEventListener("click", function () {
            if (!reason.value.trim()) {
                error.hidden = false;
                return;
            }
            // for testing lang ng frontend (pa-connect nalang sa backend pag aayusin)
            var rejTitle = document.getElementById("mTitle").textContent;
            closeReject();
            overlay.classList.remove("open");
            overlay.setAttribute("aria-hidden", "true");
            document.body.style.overflow = "";
            if (window.Notice) {
                Notice.success("Schedule rejected", "\"" + rejTitle + "\" has been rejected.");
            }
        });

        // "To Approve"-> Close, Reject, Approve
        // Approved / Completed... -> Close only
        var statusEl = document.getElementById("mStatus");
        var btnReject = document.getElementById("saReject");
        var btnApprove = document.getElementById("saApprove");

        function updateButtons() {
            var s = (statusEl.textContent || "").toLowerCase().replace(/[\s\-_]+/g, "");
            // hide Reject/Approve only for statuses that are already done
            var finished = /approved|completed|ongoing|upcoming|rejected/.test(s);
            btnReject.classList.toggle("sa-hide", finished);
            btnApprove.classList.toggle("sa-hide", finished);
        }

        new MutationObserver(updateButtons).observe(statusEl, {
            childList: true, characterData: true, subtree: true, attributes: true
        });
        // also re-check each time the pop-up opens
        new MutationObserver(updateButtons).observe(overlay, {
            attributes: true, attributeFilter: ["class"]
        });
        updateButtons();
    })();
</script>