@{
    Layout = null;
    string currentController = ViewContext.RouteData.Values["controller"].ToString();
    string currentAction = ViewContext.RouteData.Values["action"].ToString();
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Dean - @ViewBag.Title</title>
    <link href="@Url.Content("~/Content/css/layout.css")?v=1.1" rel="stylesheet" type="text/css" />
    <link href="@Url.Content("~/Content/css/Dean.css")?v=1.5" rel="stylesheet" type="text/css" />
    <link href="@Url.Content("~/Content/css/oversight.css")?v=1.0" rel="stylesheet" type="text/css" />
    <link href="@Url.Content("~/Content/css/dean-repository.css")?v=1.5" rel="stylesheet" type="text/css" />
    <link href="@Url.Content("~/Content/fontawesome/css/all.min.css")?v=1.0" rel="stylesheet" />
    <link href="@Url.Content("~/Content/css/logout-confirm.css")?v=1.0" rel="stylesheet" type="text/css" />
    <link href="@Url.Content("~/Content/css/fonts.css")?v=1.0" rel="stylesheet" type="text/css" />
    <link href="@Url.Content("~/Content/css/loading.css")?v=1.0" rel="stylesheet" type="text/css" />
    <link href="@Url.Content("~/Content/css/notice.css")?v=1.0" rel="stylesheet" type="text/css" />
</head>
<body class="user-theme">
    <header class="layout-header">
        <div class="logo-bg">
            <img src="~/Content/images/qcu.jpeg" alt="QCU Logo" class="layout-header-logo" />
            <img src="~/Content/images/ccs-logo.png" alt="CCS Logo" class="layout-header-logo" />
        </div>

        <div class="layout-header-text">
            <h1>Quezon City University</h1>
            <span>College of Computer Studies</span>
        </div>

        <div class="header-stripes">
            <span class="stripe stripe-1"></span>
            <span class="stripe stripe-2"></span>
            <span class="stripe stripe-3"></span>
        </div>

        <button type="button" id="notifBell" class="notif-bell" aria-label="Notifications" aria-expanded="false">
            <i class="fa-regular fa-bell"></i>
            <span class="notif-dot" id="notifDot"></span>
        </button>
    </header>

    <div class="layout-wrapper sidebar-rail" id="layoutWrapper">
        <aside class="layout-sidebar" id="sidebar">

            <div class="sb-top">
                <span class="sb-menu-label">MAIN MENU</span>
                <button type="button" id="sidebarToggle" class="sb-toggle" aria-label="Toggle sidebar" aria-expanded="false">
                    <i class="fa fa-bars"></i>
                </button>
            </div>

            <nav class="layout-nav">
                <a href="@Url.Action("dashboard", "Dashboard")" class="@(currentController == "Dashboard" ? "active" : "")" title="Dashboard">
                    <i class="fa fa-th-large"></i><span class="nav-label">Dashboard</span>
                </a>
                <a href="@Url.Action("ScheduleApprovalView", "ScheduleApproval")" class="@(currentController == "ScheduleApproval" ? "active" : "")" title="Schedule Approval">
                    <i class="fa fa-file-lines"></i><span class="nav-label">Schedule Approval</span>
                </a>
                <a href="@Url.Action("DefenseScheduleView", "DefenseSchedule")" class="@(currentController == "DefenseSchedule" ? "active" : "")" title="Defense Schedule">
                    <i class="fa fa-calendar"></i><span class="nav-label">Defense Schedule</span>
                </a>
                <a href="@Url.Action("Index", "Repository", new { area = "Dean" })" class="@((currentController == "Repository" || (currentController == "Oversight" && currentAction == "Records")) ? "active" : "")" title="Repository"><i class="fa fa-book-open"></i><span class="nav-label">Repository</span></a>
                <a href="@Url.Action("Cohort", "Oversight", new { area = "Dean" })" class="@((currentController == "Oversight" && (currentAction == "Cohort" || currentAction == "Exceptions" || currentAction == "Performance")) ? "active" : "")" title="Monitoring"><i class="fa fa-chart-line"></i><span class="nav-label">Monitoring</span></a>
                <a href="@Url.Action("Reports", "Oversight", new { area = "Dean" })" class="@((currentController == "Oversight" && (currentAction == "Reports" || currentAction == "Audit")) ? "active" : "")" title="Audit Reports"><i class="fa fa-clock-rotate-left"></i><span class="nav-label">Audit Reports</span></a>
            </nav>

            <div class="sb-footer">
                <a href="@Url.Action("profile", "Profile")" class="sb-user" title="Profile">
                    <span id="profilePhoto" class="sb-avatar sb-initials" aria-hidden="true"></span>
                    <span class="sb-user-text">
                        <span id="profileName" class="sb-name"></span>
                        <span id="profileRole" class="sb-role"></span>
                    </span>
                </a>
                <a href="#" id="logoutBtn" class="sb-logout" title="Logout"><i class="fa fa-sign-out-alt"></i></a>
            </div>
        </aside>

        <main class="layout-content">
            @RenderBody()
        </main>
    </div>

    <!-- Notification panel (opened by the bell in the header) -->
    <div class="notif-panel" id="notifPanel" hidden>
        <div class="notif-head">
            <div class="notif-title">
                <h3>Notifications</h3>
                <span class="notif-badge" id="notifBadge"></span>
            </div>
            <button type="button" id="notifClose" class="notif-close" aria-label="Close"><i class="fa fa-xmark"></i></button>
        </div>

        <div class="notif-tabs">
            <button type="button" class="notif-tab active" data-tab="all">All (<span id="countAll">0</span>)</button>
            <button type="button" class="notif-tab" data-tab="unread">Unread (<span id="countUnread">0</span>)</button>
        </div>

        <div class="notif-body" id="notifBody">
            @Html.Action("items", "Notification", new { area = "Dean" })
        </div>
    </div>

    <script src="~/Scripts/sidebar.js"></script>
    <script src="~/Scripts/layout-profile.js"></script>
    <script src="~/Scripts/Notifs.js"></script>
    @RenderSection("scripts", required: false)
    <script src="@Url.Content("~/Scripts/dean-notifications.js")?v=1.0"></script>
    <script src="@Url.Content("~/Scripts/logout-confirm.js")?v=1.1"></script>
    <script src="@Url.Content("~/Scripts/loading.js")?v=1.1"></script>
    <script src="@Url.Content("~/Scripts/notice.js")?v=1.0"></script>
    <script src="@Url.Content("~/Scripts/dean-schedule-privacy.js")?v=1.0"></script>
</body>
</html>
