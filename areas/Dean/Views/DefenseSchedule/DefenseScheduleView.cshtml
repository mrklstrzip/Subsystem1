@model Subsystem1.Areas.Dean.Models.DefenseScheduleViewModel
@{
    ViewBag.Title = "DefenseScheduleView";
}
<link href="@Url.Content("~/Content/css/Dean.css")?v=1.5" rel="stylesheet" type="text/css" />
<div class="dashboard-header">
    <div class="header-text">
        <h1 class="page-title">Defense Schedule</h1>
        <p class="welcome-text">View submitted defense schedules and check status</p>
    </div>
    <div class="header-bg-icon">
        <i class="fa fa-calendar-check"></i>
    </div>
</div>

@using (Html.BeginForm("DefenseScheduleView", "DefenseSchedule", FormMethod.Get, new { id = "dsFilterForm", @class = "sa-toolbar" }))
{
    <div class="sa-search">
        <i class="fa fa-magnifying-glass"></i>
        <input type="text" name="search" value="@Model.Search" placeholder="Search" autocomplete="off" />
    </div>

    <div class="sa-filter">
        <label>Program</label>
        <i class="fa-solid fa-graduation-cap"></i>
        <select name="program">
            <option value="All">All</option>
            @foreach (var p in Model.Programs)
            {
                <option value="@p" @(Model.Program == p ? "selected" : "")>@p</option>
            }
        </select>
        <i class="fa-solid fa-chevron-down sa-chev"></i>
    </div>

    <div class="sa-filter">
        <label>Status</label>
        <i class="fa-solid fa-sliders"></i>
        <select name="status">
            <option value="All">All</option>
            @foreach (var s in Model.Statuses)
            {
                <option value="@s" @(Model.Status == s ? "selected" : "")>@s</option>
            }
        </select>
        <i class="fa-solid fa-chevron-down sa-chev"></i>
    </div>

    <div class="sa-filter">
        <label>Adviser</label>
        <i class="fa-solid fa-chalkboard-user"></i>
        <select name="adviser">
            <option value="All">All</option>
            @foreach (var a in Model.Advisers)
            {
                <option value="@a" @(Model.Adviser == a ? "selected" : "")>@a</option>
            }
        </select>
        <i class="fa-solid fa-chevron-down sa-chev"></i>
    </div>
}

<div class="sa-card">
    <table class="sa-table">
        <thead>
            <tr>
                <th>MANUSCRIPT</th>
                <th>PROJECT MANAGER</th>
                <th>ADVISER</th>
                <th>DATE</th>
                <th>TIME</th>
                <th>ROOM</th>
                <th>PANELISTS</th>
                <th>STATUS</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Items.Any())
            {
                <tr><td colspan="8" class="sa-empty">No defense schedules found.</td></tr>
            }
            @foreach (var i in Model.Items)
            {
                <tr class="sa-row-click" data-sa-open data-id="@i.Id">
                    <td class="sa-title">
                        <strong>@i.Manuscript</strong>
                        <span class="sa-chip chip-@i.ProgramClass">@i.Section</span>
                    </td>
                    <td>@i.Author</td>
                    <td>@i.Adviser</td>
                    <td>@i.Date.ToString("MM-dd-yy")</td>
                    <td>@i.TimeRange</td>
                    <td>@i.Room</td>
                    <td><div class="ds-panelists">@string.Join(", ", i.Panelists)</div></td>
                    <td><span class="sa-status st-@i.StatusClass">@i.Status</span></td>
                </tr>
            }
        </tbody>
    </table>
</div>

@{
    int defenseFirstRow = Model.Total == 0 ? 0 : (Model.Page - 1) * Model.PageSize + 1;
    int defenseLastRow = Math.Min(Model.Page * Model.PageSize, Model.Total);
    int defenseFirstPage = Math.Max(1, Model.Page - 2);
    int defenseLastPage = Math.Min(Model.PageCount, Model.Page + 2);
}
<footer class="dean-defense-pagination">
    <span>Showing @defenseFirstRow-@defenseLastRow of @Model.Total defenses</span>
    <div class="dean-defense-pages">
        @if (Model.Page > 1)
        {
            <a href="@Url.Action("DefenseScheduleView", "DefenseSchedule", new { area = "Dean", search = Model.Search, program = Model.Program, status = Model.Status, adviser = Model.Adviser, page = Model.Page - 1 })">‹ Previous</a>
        }
        @for (int pageNumber = defenseFirstPage; pageNumber <= defenseLastPage; pageNumber++)
        {
            bool isCurrentPage = pageNumber == Model.Page;
            <a class="@(isCurrentPage ? "active" : "")" href="@Url.Action("DefenseScheduleView", "DefenseSchedule", new { area = "Dean", search = Model.Search, program = Model.Program, status = Model.Status, adviser = Model.Adviser, page = pageNumber })" aria-current="@(isCurrentPage ? "page" : "")">@pageNumber</a>
        }
        @if (Model.Page < Model.PageCount)
        {
            <a href="@Url.Action("DefenseScheduleView", "DefenseSchedule", new { area = "Dean", search = Model.Search, program = Model.Program, status = Model.Status, adviser = Model.Adviser, page = Model.Page + 1 })">Next ›</a>
        }
    </div>
</footer>

@Html.Partial("_ScheduleApprovalModal")

@section scripts {
    <script src="@Url.Content("~/Scripts/DeanSchedApproval.js")?v=1.4"></script>
    <script src="@Url.Content("~/Scripts/DeanDefenseSched.js")?v=1.0"></script>
    <script src="@Url.Content("~/Scripts/dean-select.js")?v=1.0"></script>
}
