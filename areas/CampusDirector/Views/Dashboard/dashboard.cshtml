@{
    ViewBag.Title = "Dashboard";
    ViewBag.ActiveMenu = "Dashboard";
}

<link href="@Url.Content("~/Content/css/campusdirector.css")?v=1.7" rel="stylesheet" type="text/css" />

<div class="dashboard-header">
    <div class="header-text">
        <h1 class="page-title">Dashboard</h1>
        <p class="welcome-text">Welcome back, <span id="dash-welcome-name">Director</span>!</p>
    </div>
    <div class="header-bg-icon">
        <i class="fa fa-th-large"></i>
    </div>
</div>

<div class="dsh-grid dsh-row-1">
    <div class="dsh-card dsh-stat">
        <div class="dsh-label">Total Rooms</div>
        <div class="dsh-value" id="dash-total-rooms">0</div>
        <div class="dsh-desc">Across all buildings</div>
        <i class="fa fa-door-closed dsh-icon" aria-hidden="true"></i>
    </div>

    <div class="dsh-card dsh-stat">
        <div class="dsh-label">Active Rooms</div>
        <div class="dsh-value" id="dash-active-rooms">0</div>
        <div class="dsh-desc">Currently available for use</div>
        <i class="fa-regular fa-circle-check dsh-icon" aria-hidden="true"></i>
    </div>

    <div class="dsh-card dsh-stat">
        <div class="dsh-label">Disabled Rooms</div>
        <div class="dsh-value" id="dash-disabled-rooms">0</div>
        <div class="dsh-desc">Under maintenance or closed</div>
        <i class="fa fa-building-circle-xmark dsh-icon" aria-hidden="true"></i>
    </div>

    <div class="dsh-card">
        <h3 class="dsh-card-title">Room per Building</h3>
        <div class="dsh-bars" id="dash-buildings"></div>
    </div>
</div>

<div class="dsh-grid dsh-row-2">
    <div class="dsh-card">
        <h3 class="dsh-card-title">Room Status</h3>
        <div class="dsh-donut-wrap">
            <svg class="dsh-donut" id="dash-donut" viewBox="0 0 200 200" role="img" aria-label="Room status chart"></svg>
            <div class="dsh-legend">
                <span><i style="background:#246a86"></i>Active Rooms</span>
                <span><i style="background:#6b97d6"></i>Disabled Rooms</span>
            </div>
        </div>
    </div>

    <div class="dsh-card">
        <h3 class="dsh-card-title">Recent Activity</h3>
        <div class="dsh-activity">
            <table class="dsh-table">
                <thead>
                    <tr><th>Timestamp</th><th>Schedule Activity</th></tr>
                </thead>
                <tbody id="dash-activity"></tbody>
            </table>
        </div>
    </div>
</div>
