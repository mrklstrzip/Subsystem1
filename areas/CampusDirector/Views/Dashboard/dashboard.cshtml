@{
    ViewBag.Title = "Dashboard";
    ViewBag.ActiveMenu = "Dashboard";
}

<link href="@Url.Content("~/Content/css/campusdirector.css")?v=3.0" rel="stylesheet" type="text/css" />

<div class="dashboard-header">
    <div class="header-text">
        <h1 class="page-title">Dashboard</h1>
        <p class="welcome-text">Welcome back, <span id="dash-welcome-name">Director</span>!</p>
    </div>
    <div class="header-bg-icon">
        <i class="fa fa-th-large"></i>
    </div>
</div>

<div class="dsh-grid dsh-row-1">
    <a class="dsh-card dsh-stat dashboard-room-stat-link" href="@Url.Action("roommanagement", "RoomManagement")" aria-label="View all rooms">
        <div class="dsh-label">Total Rooms</div>
        <div class="dsh-value" id="dash-total-rooms">0</div>
        <div class="dsh-desc">Across all buildings</div>
        <i class="fa fa-door-closed dsh-icon" aria-hidden="true"></i>
    </a>

    <a class="dsh-card dsh-stat dashboard-room-stat-link" href="@Url.Action("roommanagement", "RoomManagement")" aria-label="View active rooms">
        <div class="dsh-label">Active Rooms</div>
        <div class="dsh-value" id="dash-active-rooms">0</div>
        <div class="dsh-desc">Currently available for use</div>
        <i class="fa-regular fa-circle-check dsh-icon" aria-hidden="true"></i>
    </a>

    <a class="dsh-card dsh-stat dashboard-room-stat-link" href="@Url.Action("roommanagement", "RoomManagement")" aria-label="View disabled rooms">
        <div class="dsh-label">Disabled Rooms</div>
        <div class="dsh-value" id="dash-disabled-rooms">0</div>
        <div class="dsh-desc">Under maintenance or closed</div>
        <i class="fa fa-building-circle-xmark dsh-icon" aria-hidden="true"></i>
    </a>

</div>

<div class="dsh-grid dsh-row-2">
    <div class="dsh-chart-stack">
        <div class="dsh-card dsh-building-card">
            <h3 class="dsh-card-title">Room per Building</h3>
            <div class="dsh-bars" id="dash-buildings"></div>
        </div>
        <div class="dsh-card">
            <h3 class="dsh-card-title">Room Status</h3>
            <div class="dsh-donut-wrap">
                <div class="dsh-donut-chart">
                    <svg class="dsh-donut" id="dash-donut" viewBox="0 0 200 200" role="img" aria-label="Room status chart"></svg>
                    <div class="dsh-donut-center"><strong>0</strong><span>rooms</span></div>
                    <div class="dsh-donut-tooltip" role="status" aria-hidden="true"></div>
                </div>
                <div class="dsh-legend" id="dash-donut-legend">
                    <button type="button" data-room-status="active" aria-pressed="true" title="Click to hide or show Active Rooms"><i style="background:#246a86"></i><span>Active Rooms</span><strong>0</strong></button>
                    <button type="button" data-room-status="disabled" aria-pressed="true" title="Click to hide or show Disabled Rooms"><i style="background:#6b97d6"></i><span>Disabled Rooms</span><strong>0</strong></button>
                </div>
            </div>
        </div>
    </div>

    <div class="dsh-card">
        <h3 class="dsh-card-title">Recent Activity</h3>
        <div class="dsh-activity">
            <table class="dsh-table dashboard-recent-activity">
                <colgroup><col class="recent-date-column" style="width:180px" /><col /></colgroup>
                <thead>
                    <tr><th>DATE</th><th>ACTIVITY</th></tr>
                </thead>
                <tbody id="dash-activity"></tbody>
            </table>
        </div>
    </div>
</div>
