@{
    ViewBag.Title = "Room Schedule";
    ViewBag.ActiveMenu = "RoomSchedule";
}

<link href="@Url.Content("~/Content/css/campusdirector.css")?v=1.2" rel="stylesheet" type="text/css" />

<section class="cdb-banner">
    <div class="cdb-crumb">Campus Director | Room Schedule</div>
    <h2>Room Schedule</h2>
    <p>View room schedules and check room availability by building, date, and room status</p>
    <i class="fa-regular fa-calendar-check cdb-deco" aria-hidden="true"></i>
</section>

<div class="cdf-row">
    <div class="cdf-field">
        <label for="sc-building">Building</label>
        <select id="sc-building"><option value="all">All buildings</option></select>
    </div>
    <div class="cdf-field">
        <label for="sc-date">Date</label>
        <input type="date" id="sc-date" />
    </div>
    <div class="cdf-field">
        <label for="sc-status">Room Status</label>
        <select id="sc-status">
            <option value="all">All rooms</option>
            <option value="open">Open</option>
            <option value="occupied">Occupied</option>
            <option value="reserved">Reserved</option>
            <option value="unavailable">Unavailable</option>
            <option value="completed">Completed</option>
            <option value="cancelled">Canceled</option>
        </select>
    </div>
</div>

<div class="cds-card">
    <div class="sched-legend">
        <span class="legend-item"><span class="status-indicator-box box-open"></span> Open</span>
        <span class="legend-item"><span class="status-indicator-box box-occupied"></span> Occupied</span>
        <span class="legend-item"><span class="status-indicator-box box-reserved"></span> Reserved</span>
        <span class="legend-item"><span class="status-indicator-box box-unavailable"></span> Unavailable</span>
        <span class="legend-item"><span class="status-indicator-box box-completed"></span> Completed</span>
        <span class="legend-item"><span class="status-indicator-box box-cancelled"></span> Canceled</span>
    </div>

    <table class="sched-table">
        <thead>
            <tr id="sc-head"></tr>
        </thead>
        <tbody id="sc-body"></tbody>
    </table>
</div>

<!-- View Schedule Pop up (view only) -->
<div class="modal-overlay" id="modal-edit-sched">
    <div class="edit-sched-box">
        <div class="edit-sched-header">
            <h3>Schedule details</h3>
        </div>
        <div class="edit-sched-body">
            <div class="sched-info-card" style="margin-bottom: 24px;">
                <div class="sched-info-left" id="es-details"></div>
                <div>
                    <span class="sched-badge-occupied" id="es-badge">Open</span>
                </div>
            </div>

            <div class="edit-sched-actions">
                <button type="button" class="btn-sched-cancel" onclick="closeModal('modal-edit-sched')">Close</button>
            </div>
        </div>
    </div>
</div>
