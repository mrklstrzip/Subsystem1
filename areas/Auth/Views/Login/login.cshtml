@{
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
    ViewBag.Title = "Login";
}
<section class="auth-panel" aria-labelledby="auth-title">
    <header class="auth-panel__head"><h2 id="auth-title" class="auth-title">Login</h2></header>
    @if (TempData["Requested"] != null)
    {<p class="auth-notice" role="status">Your account request was submitted.</p>}
    <div id="loginError" class="auth-login-errors" role="alert" aria-live="polite"></div>
    <form id="loginForm" action="@Url.Action("check", "Login", new { area = "Auth" })" method="post" class="auth-form" data-auth-form="login">
        <div class="auth-field">
            <div class="f">
                <label class="f__label" for="Email">Email</label>
                <svg class="f__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z" /></svg>
                <input type="email" id="Email" name="email" class="f__control has-icon" autocomplete="username" required data-required="Enter your email address." data-email="Enter a valid email address." autofocus />
            </div><p class="auth-error" data-error-for="email" role="alert"></p>
        </div>
        <div class="auth-field">
            <div class="f">
                <label class="f__label" for="Password">Password</label>
                <svg class="f__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M18 8h-1V6a5 5 0 0 0-10 0v2H6a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V10a2 2 0 0 0-2-2zM9 6a3 3 0 0 1 6 0v2H9V6z" /></svg>
                <input type="password" id="Password" name="password" class="f__control has-icon has-eye" autocomplete="current-password" required data-required="Enter your password." data-caps="Password-hint" />
                <button type="button" class="auth-eye" data-toggle-password="Password" aria-label="Show password" aria-pressed="false"><svg class="auth-eye__on" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5C7.5 5 3.7 8 2.5 12 3.7 16 7.5 19 12 19s8.3-3 9.5-7C20.3 8 16.5 5 12 5zm0 11a4 4 0 1 1 0-8 4 4 0 0 1 0 8z" /></svg><svg class="auth-eye__off" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 3l18 18M9.8 9.9A3 3 0 0 0 14.2 14M6.5 6.7C4.6 7.9 3.2 9.8 2.5 12 3.7 16 7.5 19 12 19c2 0 3.8-.6 5.4-1.6M11 5.1h1c4.5 0 8.3 3 9.5 6.9-.3.9-.7 1.7-1.2 2.5" /></svg></button>
            </div><p class="auth-hint" id="Password-hint" hidden>Caps Lock is on.</p><p class="auth-error" data-error-for="password" role="alert"></p>
        </div>
        <div class="auth-forgot"><a href="@Url.Action("forgotpassword", "ForgotPassword", new { area = "Auth" })">Forgot Password?</a></div>
        <div class="auth-actions"><button type="submit" class="auth-btn" data-busy-text="Signing in…">Login</button></div>
    </form>
</section>
<script src="@Url.Content("~/Scripts/login-check.js")?v=1.2"></script>
