@{
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
    ViewBag.Title = "Forgot Password";
}

<link href="@Url.Content("~/Content/css/fonts.css")?v=1.0" rel="stylesheet" type="text/css" />

<section class="auth-panel" aria-labelledby="auth-title">
    <header class="auth-panel__head">
        <h2 id="auth-title" class="auth-title">Forgot Password</h2>
        <p class="auth-lede">Enter the email linked to your account and we'll help you reset your password.</p>
    </header>

    <!-- STEP 1: enter email -->
    <form id="stepEmail" class="auth-form forgot-step" novalidate>
        <div class="auth-field">
            <div class="f">
                <label class="f__label" for="fpEmail">Email</label>
                <input type="email" id="fpEmail" name="Email" class="f__control" autocomplete="username" required />
            </div>
        </div>
        <p class="auth-error" id="emailError" role="alert" hidden></p>
        <div class="auth-actions">
            <button type="submit" class="auth-btn">Send Code</button>
        </div>
        <p class="auth-sub">Remembered it? <a href="@Url.Action("login", "Login", new { area = "Auth" })">Back to Login</a></p>
    </form>

    <!-- STEP 2: enter verification code -->
    <form id="stepCode" class="auth-form forgot-step" hidden>
        <p class="auth-sub" id="codeDesc">Enter the 6-digit code for your account.</p>
        <div class="auth-field">
            <div class="f">
                <label class="f__label" for="fpCode">Verification Code</label>
                <input type="text" id="fpCode" name="Code" class="f__control" inputmode="numeric" maxlength="6" autocomplete="one-time-code" required />
            </div>
        </div>
        <p class="auth-error" id="codeError" role="alert" hidden></p>
        <div class="auth-actions">
            <button type="submit" class="auth-btn">Verify Code</button>
        </div>
        <p class="auth-sub">Didn't get it? <a href="#" id="resendCode">Resend code</a> · <a href="#" id="changeEmail">Change email</a></p>
    </form>

    <!-- STEP 3: choose a new password -->
    <form id="stepReset" class="auth-form forgot-step" hidden>
        <p class="auth-sub">Choose a new password (at least 8 characters).</p>
        <div class="auth-field">
            <div class="f">
                <label class="f__label" for="fpNewPass">New Password</label>
                <input type="password" id="fpNewPass" name="NewPassword" class="f__control" autocomplete="new-password" required />
                <button type="button" class="auth-eye toggle-password" aria-label="Show or hide new password">Show</button>
            </div>
        </div>
        <div class="auth-field">
            <div class="f">
                <label class="f__label" for="fpConfirmPass">Confirm Password</label>
                <input type="password" id="fpConfirmPass" name="ConfirmPassword" class="f__control" autocomplete="new-password" required />
                <button type="button" class="auth-eye toggle-password" aria-label="Show or hide confirm password">Show</button>
            </div>
        </div>
        <p class="auth-error" id="resetError" role="alert" hidden></p>
        <div class="auth-actions">
            <button type="submit" class="auth-btn">Reset Password</button>
        </div>
        <p class="auth-sub"><a href="@Url.Action("login", "Login", new { area = "Auth" })">Back to Login</a></p>
    </form>
</section>

<script src="@Url.Content("~/Scripts/forgotpassword.js")?v=2.0"></script>
