
@using System.Linq
@using Subsystem1.Areas.CapstoneCoordinator.Models
@model CoordinatorData
@{
    ViewBag.Title = "Defense Schedule";
}

<link href="@Url.Content("~/Content/css/capstonecoordinator/defenseschedule.css")?v=2.4" rel="stylesheet" type="text/css" />

<!-- Header Banner -->
<div class="dashboard-header">
    <div class="header-text">
        <h1 class="page-title">Defense Schedule</h1>
        <p class="welcome-text">View submitted defense schedules and check status</p>
    </div>
    <div class="header-bg-icon">
        <i class="fa fa-calendar-day"></i>
    </div>
</div>

<!-- Controls Container Card -->
<div class="controls-card">
    <div class="search-container">
        <div class="search">
            <i class="fa fa-search"></i>
            <input type="text" id="searchInput" placeholder="Search">
        </div>
    </div>

    <div class="filter-wrapper">
        <!-- Program Filter Box -->
        <div class="custom-select-box">
            <span class="filter-legend">Program</span>
            <div class="select-selected">
                <i class="fa fa-graduation-cap"></i>
                <span>All</span>
                <i class="fa-solid fa-chevron-down chevron"></i>
            </div>
        </div>

        <!-- Status Filter Box -->
        <div class="custom-select-box">
            <span class="filter-legend">Status</span>
            <div class="select-selected">
                <i class="fa-solid fa-sliders"></i>
                <span>All</span>
                <i class="fa-solid fa-chevron-down chevron"></i>
            </div>
        </div>

        <!-- Adviser Filter Box -->
        <div class="custom-select-box">
            <span class="filter-legend">Adviser</span>
            <div class="select-selected">
                <i class="fa-solid fa-chalkboard-user"></i>
                <span>All</span>
                <i class="fa-solid fa-chevron-down chevron"></i>
            </div>
        </div>
    </div>
</div>

<!-- Defense Schedule Table Section (click a row to view its schedule) -->
<div class="schedule-management-card">
    <table class="schedule-table" id="defenseScheduleTable">
        <thead>
            <tr>
                <th class="column-title manuscript-col">MANUSCRIPT</th>
                <th class="column-title author-col">PROJECT MANAGER</th>
                <th class="column-title adviser-col">ADVISER</th>
                <th class="column-title date-col">DATE</th>
                <th class="column-title time-col">TIME</th>
                <th class="column-title room-col">ROOM</th>
                <th class="column-title status-col">STATUS</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var d in Model.Defenses)
            {
                <tr class="clickable-row" tabindex="0" data-id="@d.Id" data-status="@d.Status">
                    <td>
                        <div class="manuscript-title-text">@d.Title</div>
                        <span class="program-badge @d.BadgeClass">@d.Badge</span>
                    </td>
                    <td class="author-cell">@d.Author</td>
                    <td class="adviser-cell">@d.Adviser</td>
                    <td class="date-cell">@d.DateText</td>
                    <td class="time-cell">@d.TimeText</td>
                    <td class="room-cell">@d.Room</td>
                    <td>
                        <span class="status-badge @d.Status">@d.StatusLabel</span>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- ==========================================================
     Defense Schedule Modal (read-only)
     Same layout for Upcoming / Ongoing / Completed;
     only the status badge changes. Close button only.
     ========================================================== -->
<div class="modal-overlay" id="defenseModal" aria-hidden="true">
    <div class="schedule-modal" role="dialog" aria-modal="true" aria-labelledby="modalHeading">

        <button type="button" class="modal-close-icon" id="modalCloseIcon" aria-label="Close">
            <i class="fa-solid fa-xmark"></i>
        </button>

        <h2 class="modal-heading" id="modalHeading">Defense Schedule</h2>
        <p class="modal-subheading">College of Computer Studies - QCU &nbsp;·&nbsp; Defense Schedule</p>

        <!-- Summary card -->
        <div class="modal-summary">
            <div class="summary-row summary-row-4">
                <div class="summary-item">
                    <span class="summary-label">Project Title</span>
                    <span class="summary-value" id="mTitle"></span>
                </div>
                <div class="summary-item">
                    <span class="summary-label">Date Submitted</span>
                    <span class="summary-value" id="mDateSubmitted"></span>
                </div>
                <div class="summary-item">
                    <span class="summary-label">Problem</span>
                    <span class="summary-value" id="mProblem">&mdash;</span>
                </div>
                <div class="summary-item">
                    <span class="summary-label">Current Status</span>
                    <span class="status-badge" id="mStatus"></span>
                </div>
            </div>
            <div class="summary-divider"></div>
            <div class="summary-row summary-row-3">
                <div class="summary-item">
                    <span class="summary-label">Project Manager</span>
                    <span class="summary-value" id="mStudent"></span>
                </div>
                <div class="summary-item">
                    <span class="summary-label">Program</span>
                    <span class="summary-value" id="mProgram"></span>
                </div>
                <div class="summary-item">
                    <span class="summary-label">Adviser</span>
                    <span class="summary-value" id="mAdviser"></span>
                </div>
            </div>
        </div>

        <!-- Body: Abstract + Panelists -->
        <div class="modal-body-grid">
            <div class="modal-panel abstract-panel">
                <div class="manuscript-viewer-header">
                    <h3 class="panel-title">Manuscript</h3>
                    <a id="mManuscriptOpen" class="manuscript-open-link" target="_blank" rel="noopener" hidden>Open PDF</a>
                </div>
                <div class="pdf-viewer" aria-label="Manuscript PDF viewer">
                    <div class="pdf-toolbar">
                        <button type="button" id="pdfPrev" aria-label="Previous page">‹</button>
                        <span><span id="pdfPage">—</span> / <span id="pdfPages">—</span></span>
                        <button type="button" id="pdfNext" aria-label="Next page">›</button>
                        <button type="button" id="pdfZoomOut" aria-label="Zoom out">−</button>
                        <button type="button" id="pdfZoomIn" aria-label="Zoom in">+</button>
                    </div>
                    <div class="pdf-canvas-wrap" id="pdfCanvasWrap">
                        <canvas id="pdfCanvas" hidden></canvas>
                        <p class="pdf-message" id="pdfMessage">No PDF manuscript is available for this submission.</p>
                    </div>
                </div>
                <span class="panel-footnote" id="mSubmittedNote"></span>
            </div>

            <div class="modal-panel panelists-panel">
                <div class="panel-header-row">
                    <h3 class="panel-title no-margin">Assigned Panelists</h3>
                </div>

                <div class="panelist-head">
                    <span>Panelists</span>
                    <span>Expertise Match</span>
                </div>
                <div id="mPanelists"></div>

                <h3 class="panel-title schedule-title">Proposed Defense Schedule</h3>
                <dl class="defense-schedule">
                    <div><dt>TIME</dt><dd id="mTime"></dd></div>
                    <div><dt>DATE</dt><dd id="mDate"></dd></div>
                    <div><dt>BUILDING</dt><dd id="mBuilding"></dd></div>
                    <div><dt>ROOM</dt><dd id="mRoom"></dd></div>
                </dl>
            </div>
        </div>

        <!-- Footer -->
        <div class="modal-footer">
            <button type="button" class="btn-modal btn-modal-close" id="modalCloseBtn">Close</button>
        </div>
    </div>
</div>

<script src="@Url.Content("~/Scripts/capstonecoordinator-app.js")?v=2.0"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
<script>
    (function () {
        var API = "/CapstoneCoordinator/CoordinatorApi/";
        var STATUS_LABELS = { "upcoming": "Upcoming", "ongoing": "Ongoing", "completed": "Completed" };
        var MONTHS = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
        var DEFAULT_PERCENT = { high: 90, medium: 70, low: 40 };

        var overlay = document.getElementById("defenseModal");
        var busy = false;
        var pdfDocument = null;
        var pdfPageNumber = 1;
        var pdfZoom = 1;
        var pdfLoadId = 0;
        var pdfRenderTask = null;
        if (window.pdfjsLib) {
            window.pdfjsLib.GlobalWorkerOptions.workerSrc =
                "https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js";
        }

        function $(id) {
            return document.getElementById(id);
        }

        function fmtDate(iso) {
            if (!iso) return "\u2014";
            var p = iso.split("-");
            return MONTHS[parseInt(p[1], 10) - 1] + " " + parseInt(p[2], 10) + ", " + p[0];
        }

        function fmtTime(t) {
            if (!t) return "";
            var p = t.split(":");
            var h = parseInt(p[0], 10);
            var ap = h >= 12 ? "PM" : "AM";
            h = h % 12 || 12;
            return h + ":" + p[1] + ap;
        }

        function renderPdfPage() {
            if (!pdfDocument) return;
            var canvas = $("pdfCanvas");
            var context = canvas.getContext("2d");
            pdfDocument.getPage(pdfPageNumber).then(function (page) {
                var base = page.getViewport({ scale: 1 });
                var maxWidth = $("pdfCanvasWrap").clientWidth - 24;
                var viewport = page.getViewport({ scale: Math.min(maxWidth / base.width, 1.5) * pdfZoom });
                var ratio = window.devicePixelRatio || 1;
                canvas.width = Math.floor(viewport.width * ratio);
                canvas.height = Math.floor(viewport.height * ratio);
                canvas.style.width = Math.floor(viewport.width) + "px";
                canvas.style.height = Math.floor(viewport.height) + "px";
                context.setTransform(ratio, 0, 0, ratio, 0, 0);
                if (pdfRenderTask) pdfRenderTask.cancel();
                pdfRenderTask = page.render({ canvasContext: context, viewport: viewport });
                pdfRenderTask.promise.catch(function () { });
                $("pdfPage").textContent = pdfPageNumber;
                $("pdfPages").textContent = pdfDocument.numPages;
                $("pdfPrev").disabled = pdfPageNumber <= 1;
                $("pdfNext").disabled = pdfPageNumber >= pdfDocument.numPages;
            });
        }

        function loadManuscript(url) {
            var id = ++pdfLoadId;
            var link = $("mManuscriptOpen");
            var message = $("pdfMessage");
            var canvas = $("pdfCanvas");
            if (pdfRenderTask) { pdfRenderTask.cancel(); pdfRenderTask = null; }
            if (pdfDocument) { pdfDocument.destroy(); pdfDocument = null; }
            canvas.hidden = true;
            $("pdfPage").textContent = $("pdfPages").textContent = "—";
            var parsed;
            try { parsed = new URL(url || "", window.location.href); } catch (e) { parsed = null; }
            var valid = parsed && (parsed.protocol === "https:" || parsed.protocol === "http:") &&
                (/\.pdf(?:$|[&#?])/i.test(parsed.pathname + parsed.search) || /\/CoordinatorApi\/manuscript$/i.test(parsed.pathname));
            link.hidden = !valid;
            if (valid) link.href = parsed.href;
            if (!valid) { message.hidden = false; message.textContent = "No PDF manuscript is available for this submission."; return; }
            message.hidden = false;
            message.textContent = "Loading manuscript…";
            if (!window.pdfjsLib) { message.textContent = "The PDF viewer could not be loaded. Use Open PDF to view the manuscript."; return; }
            window.pdfjsLib.getDocument({ url: parsed.href, withCredentials: parsed.origin === window.location.origin }).promise.then(function (doc) {
                if (id !== pdfLoadId) { doc.destroy(); return; }
                pdfDocument = doc;
                pdfPageNumber = 1;
                pdfZoom = 1;
                canvas.hidden = false;
                message.hidden = true;
                renderPdfPage();
            }).catch(function () {
                if (id === pdfLoadId) message.textContent = "Could not render this PDF. Check that the Cloudinary file is accessible, then use Open PDF.";
            });
        }

        function show(row, d) {
            $("mTitle").textContent = d.title;
            $("mDateSubmitted").textContent = d.dateSubmitted;
            $("mStudent").textContent = d.student;
            $("mProgram").textContent = d.program;
            $("mAdviser").textContent = d.adviser;

            var st = row.getAttribute("data-status");
            var badge = $("mStatus");
            badge.className = "status-badge " + st;
            badge.textContent = STATUS_LABELS[st] || st;

            $("mSubmittedNote").textContent = d.dateSubmitted && d.dateSubmitted !== "-"
                ? "Submitted " + d.dateSubmitted
                : "";
            loadManuscript("/CapstoneCoordinator/CoordinatorApi/manuscript?id=" + encodeURIComponent(d.subsystem2Id || d.id || ""));

            var list = $("mPanelists");
            list.innerHTML = "";

            (d.panelists || []).forEach(function (p) {
                var lvl = String(p.match || "").toLowerCase();

                var r = document.createElement("div");
                r.className = "panelist-row";

                var name = document.createElement("span");
                name.className = "panelist-name";
                name.textContent = p.name;
                var role = document.createElement("small");
                role.className = "panelist-role " + String(p.role || "Member").toLowerCase();
                role.textContent = p.role || "Member";
                name.appendChild(role);

                var wrap = document.createElement("span");
                wrap.className = "match-wrap";

                var pct = document.createElement("span");
                pct.className = "match-percent";
                pct.textContent = (p.percent != null && !isNaN(p.percent))
                    ? Number(p.percent).toFixed(1) + "%"
                    : "\u2014";

                var pill = document.createElement("span");
                pill.className = "match-pill " + lvl;
                pill.textContent = lvl.charAt(0).toUpperCase() + lvl.slice(1);

                wrap.appendChild(pct);
                wrap.appendChild(pill);

                r.appendChild(name);
                r.appendChild(wrap);
                list.appendChild(r);
            });

            $("mTime").textContent = fmtTime(d.start) + " - " + fmtTime(d.end);
            $("mDate").textContent = fmtDate(d.date);
            $("mBuilding").textContent = d.building || "\u2014";
            $("mRoom").textContent = d.room || "\u2014";

            overlay.classList.add("open");
            overlay.setAttribute("aria-hidden", "false");
            document.body.classList.add("modal-open");
        }

        //for testing lang ng frontend para makita itsura (pa remove nalang pag aayusin backend)
        function openModal(row) {
            if (busy) return;
            busy = true;

            fetch(API + "schedule?id=" + encodeURIComponent(row.getAttribute("data-id")), {
                credentials: "same-origin",
                cache: "no-store",
                headers: { "X-Requested-With": "XMLHttpRequest" }
            }).then(function (r) {
                return r.json();
            }).then(function (res) {
                busy = false;

                if (res && res.unauthorized) {
                    window.location.href = "/Auth/Login/login";
                    return;
                }

                if (!res || !res.success) {
                    alert((res && res.message) || "Could not open this schedule.");
                    return;
                }

                show(row, res.schedule);
            }, function () {
                busy = false;
                alert("Could not reach the server. Please check your connection and try again.");
            });
        }

        function closeModal() {
            overlay.classList.remove("open");
            overlay.setAttribute("aria-hidden", "true");
            document.body.classList.remove("modal-open");
        }

        document.querySelectorAll(".clickable-row").forEach(function (row) {
            row.addEventListener("click", function () {
                openModal(row);
            });

            row.addEventListener("keydown", function (e) {
                if (e.key === "Enter" || e.key === " ") {
                    e.preventDefault();
                    openModal(row);
                }
            });
        });

        $("modalCloseIcon").addEventListener("click", closeModal);
        $("modalCloseBtn").addEventListener("click", closeModal);
        $("pdfPrev").addEventListener("click", function () { if (pdfPageNumber > 1) { pdfPageNumber--; renderPdfPage(); } });
        $("pdfNext").addEventListener("click", function () { if (pdfDocument && pdfPageNumber < pdfDocument.numPages) { pdfPageNumber++; renderPdfPage(); } });
        $("pdfZoomOut").addEventListener("click", function () { pdfZoom = Math.max(.6, pdfZoom - .15); renderPdfPage(); });
        $("pdfZoomIn").addEventListener("click", function () { pdfZoom = Math.min(2, pdfZoom + .15); renderPdfPage(); });
        window.addEventListener("resize", function () { if (pdfDocument && overlay.classList.contains("open")) renderPdfPage(); });

        overlay.addEventListener("click", function (e) {
            if (e.target === overlay) closeModal();
        });

        document.addEventListener("keydown", function (e) {
            if (e.key === "Escape") closeModal();
        });
    })();
</script>
