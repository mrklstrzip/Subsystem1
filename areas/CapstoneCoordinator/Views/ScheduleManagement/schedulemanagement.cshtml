@using System.Linq
@using Subsystem1.Areas.CapstoneCoordinator.Models
@model CoordinatorData
@{
    ViewBag.Title = "Manuscript Management";
}

<link href="@Url.Content("~/Content/css/capstonecoordinator/schedulemanagement.css")?v=3.5" rel="stylesheet" type="text/css" />

<!-- Header Banner -->
<div class="dashboard-header">
    <div class="header-text">
        <h1 class="page-title">Manuscript Management</h1>
        <p class="welcome-text">Generate and edit schedule</p>
    </div>
    <div class="header-bg-icon">
        <i class="fa fa-file-lines"></i>
    </div>
</div>

<!-- Controls Container Card -->
<div class="controls-card">
    <div class="search-container">
        <div class="search">
            <i class="fa fa-search"></i>
            <input type="text" id="searchInput" placeholder="Search">
        </div>
    </div>

    <div class="filter-wrapper">
        <!-- Program Filter Box -->
        <div class="custom-select-box">
            <span class="filter-legend">Program</span>
            <div class="select-selected">
                <i class="fa fa-graduation-cap"></i>
                <span>All</span>
                <i class="fa-solid fa-chevron-down chevron"></i>
            </div>
        </div>

        <!-- Status Filter Box -->
        <div class="custom-select-box">
            <span class="filter-legend">Status</span>
            <div class="select-selected">
                <i class="fa-solid fa-sliders"></i>
                <span>All</span>
                <i class="fa-solid fa-chevron-down chevron"></i>
            </div>
        </div>

        <!-- Adviser Filter Box -->
        <div class="custom-select-box">
            <span class="filter-legend">Adviser</span>
            <div class="select-selected">
                <i class="fa-solid fa-chalkboard-user"></i>
                <span>All</span>
                <i class="fa-solid fa-chevron-down chevron"></i>
            </div>
        </div>

        <!-- Notify PM Button -->
        <button type="button" class="btn-notify-pm" id="btnNotifyPm">
            <i class="fa-solid fa-bell"></i>
            <span>Notify PM</span>
        </button>
    </div>
</div>

<!-- Schedule Management Table Section -->
<div class="schedule-management-card">
    <table class="schedule-table" id="scheduleTable">
        <thead>
            <tr>
                <th class="column-title manuscript-col">MANUSCRIPT</th>
                <th class="column-title author-col">PROJECT MANAGER</th>
                <th class="column-title adviser-col">ADVISER</th>
                <th class="column-title date-col">DATE</th>
                <th class="column-title status-col">STATUS</th>
                <th class="column-title action-col">ACTION</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in Model.Schedules)
            {
                <tr data-id="@s.Id">
                    <td>
                        <div class="manuscript-title-text">@s.Title</div>
                        <span class="program-badge @s.BadgeClass">@s.Badge</span>
                    </td>
                    <td class="author-cell">@s.Author</td>
                    <td class="adviser-cell">@s.Adviser</td>
                    <td class="date-cell">@s.DateText</td>
                    <td>
                        <span class="status-badge @s.Status">@s.StatusLabel</span>
                    </td>
                    <td class="action-cell">
                        <button class="btn-view" data-id="@s.Id">View</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>


<div class="modal-overlay" id="scheduleModal" aria-hidden="true">
    <div class="schedule-modal" role="dialog" aria-modal="true" aria-labelledby="modalHeading">

        <button type="button" class="modal-close-icon" id="modalCloseIcon" aria-label="Close">
            <i class="fa-solid fa-xmark"></i>
        </button>

        <h2 class="modal-heading" id="modalHeading">Generated Schedule</h2>
        <p class="modal-subheading">College of Computer Studies - QCU &nbsp;·&nbsp; Defense Schedule</p>

        <!-- Summary card -->
        <div class="modal-summary">
            <div class="summary-row summary-row-4">
                <div class="summary-item">
                    <span class="summary-label">Project Title</span>
                    <span class="summary-value" id="mTitle"></span>
                </div>
                <div class="summary-item">
                    <span class="summary-label">Date Submitted</span>
                    <span class="summary-value" id="mDateSubmitted"></span>
                </div>
                <div class="summary-item">
                    <span class="summary-label">Problem</span>
                    <span class="summary-value" id="mProblem"></span>
                </div>
                <div class="summary-item">
                    <span class="summary-label">Current Status</span>
                    <span class="status-badge" id="mStatus"></span>
                </div>
            </div>
            <div class="summary-divider"></div>
            <div class="summary-row summary-row-3">
                <div class="summary-item">
                    <span class="summary-label">Project Manager</span>
                    <span class="summary-value" id="mStudent"></span>
                </div>
                <div class="summary-item">
                    <span class="summary-label">Program</span>
                    <span class="summary-value" id="mProgram"></span>
                </div>
                <div class="summary-item">
                    <span class="summary-label">Adviser</span>
                    <span class="summary-value" id="mAdviser"></span>
                </div>
            </div>
        </div>

        <!-- Body: Abstract + Panelists -->
        <div class="modal-body-grid">
            <div class="modal-panel abstract-panel">
                <h3 class="panel-title">Abstract</h3>
                <p class="panel-text" id="mAbstract"></p>

                <h3 class="panel-title">Keywords</h3>
                <p class="panel-text" id="mKeywords"></p>

                <span class="panel-footnote" id="mSubmittedNote"></span>
            </div>

            <div class="modal-panel panelists-panel">
                <div class="panel-header-row">
                    <h3 class="panel-title no-margin">Assigned Panelists</h3>
                    <div class="edit-actions">
                        <button type="button" class="btn-edit-panelists" id="btnEditPanelists" title="Edit panelists and schedule">
                            <i class="fa-solid fa-pen"></i>
                        </button>
                        <button type="button" class="btn-edit-panelists btn-cancel-edit" id="btnCancelEdit" title="Cancel" hidden>
                            <i class="fa-solid fa-xmark"></i>
                        </button>
                        <button type="button" class="btn-edit-panelists btn-save-edit" id="btnSaveEdit" title="Save changes" hidden>
                            <i class="fa-solid fa-check"></i>
                        </button>
                    </div>
                </div>

                <div class="panelist-head">
                    <span>Panelists</span>
                    <span>Expertise Match</span>
                </div>
                <div id="mPanelists"></div>

                <h3 class="panel-title schedule-title">Proposed Defense Schedule</h3>
                <dl class="defense-schedule">
                    <div>
                        <dt>TIME</dt>
                        <dd>
                            <span class="view-val" id="mTime"></span>
                            <span class="edit-val">
                                <input type="time" class="edit-input" id="eTimeStart" aria-label="Start time">
                                <span class="time-sep">&ndash;</span>
                                <input type="time" class="edit-input" id="eTimeEnd" aria-label="End time">
                            </span>
                        </dd>
                    </div>
                    <div>
                        <dt>DATE</dt>
                        <dd>
                            <span class="view-val" id="mDate"></span>
                            <span class="edit-val">
                                <input type="date" class="edit-input" id="eDate" aria-label="Defense date">
                            </span>
                        </dd>
                    </div>
                    <div>
                        <dt>BUILDING</dt>
                        <dd>
                            <span class="view-val" id="mBuilding"></span>
                            <span class="edit-val">
                                <input type="text" class="edit-input building-input" id="eBuilding" maxlength="30" aria-label="Building">
                            </span>
                        </dd>
                    </div>
                    <div>
                        <dt>ROOM</dt>
                        <dd>
                            <span class="view-val" id="mRoom"></span>
                            <span class="edit-val">
                                <input type="text" class="edit-input room-input" id="eRoom" maxlength="20" aria-label="Room">
                            </span>
                        </dd>
                    </div>
                </dl>
                <p class="edit-error" id="mEditError" hidden></p>
            </div>
        </div>

        <!-- Footer buttons -->
        <div class="modal-footer">
            <button type="button" class="btn-modal btn-modal-close" id="modalCloseBtn">Close</button>
            <button type="button" class="btn-modal btn-modal-submit" id="modalSubmitBtn">Submit</button>
        </div>
    </div>
</div>


<datalist id="facultyList">
    @foreach (var n in Model.FacultyNames)
    {
        <option value="@n"></option>
    }
</datalist>
<datalist id="roomList">
    @foreach (var n in Model.RoomNames)
    {
        <option value="@n"></option>
    }
</datalist>

<script src="@Url.Content("~/Scripts/capstonecoordinator-app.js")?v=2.0"></script>
<script src="@Url.Content("~/Scripts/coordinator-schedule-modal.js")?v=1.0"></script>
<script>
    (function () {
        // each "View" button opens the pop-up of its schedule (the data comes from the database)
        document.getElementById("scheduleTable").addEventListener("click", function (e) {
            var btn = e.target.closest ? e.target.closest(".btn-view") : null;
            if (btn) CCSchedule.open(btn.getAttribute("data-id"));
        });


        //for testing lang ng frontend para makita itsura (pa remove nalang pag aayusin backend)
        var notifyBtn = document.getElementById("btnNotifyPm");
        if (notifyBtn) notifyBtn.addEventListener("click", function () {
            Notice.success("Notification sent", "All project managers who haven't submitted their manuscript have been notified.");
        });

        var panelists = document.getElementById("mPanelists");
        var defaultPercent = { high: 90, medium: 70, low: 40 };

        function addPercents() {
            var pills = panelists.querySelectorAll(".match-pill");
            for (var i = 0; i < pills.length; i++) {
                var pill = pills[i];
                if (pill.parentNode.classList.contains("match-wrap")) continue;

                var level = pill.classList.contains("high") ? "high"
                    : pill.classList.contains("medium") ? "medium" : "low";

                var pct = document.createElement("span");
                pct.className = "match-percent";
                pct.textContent = (pill.getAttribute("data-percent") || defaultPercent[level]) + "%";

                var wrap = document.createElement("span");
                wrap.className = "match-wrap";
                pill.parentNode.insertBefore(wrap, pill);
                wrap.appendChild(pct);
                wrap.appendChild(pill);
            }
        }
        new MutationObserver(addPercents).observe(panelists, { childList: true, subtree: true });
        addPercents();

        var mBuilding = document.getElementById("mBuilding");
        var eBuilding = document.getElementById("eBuilding");
        mBuilding.textContent = "-";

        document.getElementById("btnEditPanelists").addEventListener("click", function () {
            eBuilding.value = mBuilding.textContent === "-" ? "" : mBuilding.textContent;
        });
        document.getElementById("btnSaveEdit").addEventListener("click", function () {
            mBuilding.textContent = eBuilding.value.trim() || "-";
        });
        new MutationObserver(function () { mBuilding.textContent = "-"; })
            .observe(document.getElementById("mTitle"), { childList: true, characterData: true, subtree: true });
    })();
</script>
