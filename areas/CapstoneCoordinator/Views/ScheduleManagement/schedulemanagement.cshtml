@{
    ViewBag.Title = "Schedule Management";
}

<link href="@Url.Content("~/Content/css/capstonecoordinator/schedulemanagement.css")?v=3.4" rel="stylesheet" type="text/css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<!-- Header Banner -->
<div class="dashboard-header">
    <div class="header-text">
        <span class="breadcrumb-text">Capstone Coordinator | Defense Management</span>
        <h1 class="page-title">Schedule Management</h1>
        <p class="welcome-text">Generate and edit schedule</p>
    </div>
    <div class="header-bg-icon">
        <i class="fa fa-file-lines"></i>
    </div>
</div>

<!-- Controls Container Card -->
<div class="controls-card">
    <div class="search-container">
        <div class="search">
            <i class="fa fa-search"></i>
            <input type="text" id="searchInput" placeholder="Search">
        </div>
    </div>

    <div class="filter-wrapper">
        <!-- Program Filter Box -->
        <div class="custom-select-box">
            <span class="filter-legend">Program</span>
            <div class="select-selected">
                <i class="fa fa-graduation-cap"></i>
                <span>All</span>
                <i class="fa-solid fa-chevron-down chevron"></i>
            </div>
        </div>

        <!-- Status Filter Box -->
        <div class="custom-select-box">
            <span class="filter-legend">Status</span>
            <div class="select-selected">
                <i class="fa-solid fa-sliders"></i>
                <span>All</span>
                <i class="fa-solid fa-chevron-down chevron"></i>
            </div>
        </div>

        <!-- Adviser Filter Box -->
        <div class="custom-select-box">
            <span class="filter-legend">Adviser</span>
            <div class="select-selected">
                <i class="fa-solid fa-chalkboard-user"></i>
                <span>All</span>
                <i class="fa-solid fa-chevron-down chevron"></i>
            </div>
        </div>
    </div>
</div>

