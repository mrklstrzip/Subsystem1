@using System.Linq
@using Subsystem1.Areas.CapstoneCoordinator.Models
@model CoordinatorData
@{
    ViewBag.Title = "Manuscript Management";
}

<link href="@Url.Content("~/Content/css/capstonecoordinator/schedulemanagement.css")?v=3.9" rel="stylesheet" type="text/css" />

<!-- Header Banner -->
<div class="dashboard-header">
    <div class="header-text">
        <h1 class="page-title">Manuscript Management</h1>
        <p class="welcome-text">Generate and edit schedule</p>
    </div>
    <div class="header-bg-icon">
        <i class="fa fa-file-lines"></i>
    </div>
</div>

<!-- Controls Container Card -->
<div class="controls-card">
    <div class="search-container">
        <div class="search">
            <i class="fa fa-search"></i>
            <input type="text" id="searchInput" placeholder="Search">
        </div>
    </div>

    <div class="filter-wrapper">
        <!-- Program Filter Box -->
        <div class="custom-select-box">
            <span class="filter-legend">Program</span>
            <div class="select-selected">
                <i class="fa fa-graduation-cap"></i>
                <span>All</span>
                <i class="fa-solid fa-chevron-down chevron"></i>
            </div>
        </div>

        <!-- Status Filter Box -->
        <div class="custom-select-box">
            <span class="filter-legend">Status</span>
            <div class="select-selected">
                <i class="fa-solid fa-sliders"></i>
                <span>All</span>
                <i class="fa-solid fa-chevron-down chevron"></i>
            </div>
        </div>

        <!-- Adviser Filter Box -->
        <div class="custom-select-box">
            <span class="filter-legend">Adviser</span>
            <div class="select-selected">
                <i class="fa-solid fa-chalkboard-user"></i>
                <span>All</span>
                <i class="fa-solid fa-chevron-down chevron"></i>
            </div>
        </div>

        <!-- Notify PM Button -->
        <button type="button" class="btn-notify-pm" id="btnNotifyPm">
            <i class="fa-solid fa-bell"></i>
            <span>Notify PM</span>
        </button>
    </div>
</div>

<!-- Schedule Management Table Section -->
<div class="schedule-management-card">
    <table class="schedule-table" id="scheduleTable">
        <thead>
            <tr>
                <th class="column-title manuscript-col">MANUSCRIPT</th>
                <th class="column-title author-col">PROJECT MANAGER</th>
                <th class="column-title adviser-col">ADVISER</th>
                <th class="column-title type-col">TYPE</th>
                <th class="column-title date-col">DATE</th>
                <th class="column-title status-col">STATUS</th>
                <th class="column-title action-col">ACTION</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in Model.Schedules)
            {
                <tr data-id="@s.Id" data-sy="@s.SchoolYear">
                    <td>
                        <div class="manuscript-title-text">@(s.Status == "not-submitted" ? "\u2014" : s.Title)</div>
                        <span class="program-badge @s.BadgeClass">@s.Badge</span>
                    </td>
                    <td class="author-cell">@s.Author</td>
                    <td class="adviser-cell">@s.Adviser</td>
                    <td class="type-cell"><span class="defense-type-badge @s.TypeClass">@s.Type</span></td>
                    <td class="date-cell">@s.DateText</td>
                    <td>
                        <span class="status-badge @s.Status">@s.StatusLabel</span>
                    </td>
                    <td class="action-cell">
                        @if (s.Status == "not-submitted")
                        {
                            <span class="no-action">&mdash;</span>
                        }
                        else
                        {
                            <button class="btn-view" data-id="@s.Id">View</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@{
    int showingFrom = Model.ScheduleTotalCount == 0 ? 0 : (Model.SchedulePage - 1) * Model.SchedulePageSize + 1;
    int showingTo = Math.Min(Model.SchedulePage * Model.SchedulePageSize, Model.ScheduleTotalCount);
    int firstPageLink = Math.Max(1, Model.SchedulePage - 2);
    int lastPageLink = Math.Min(Model.SchedulePageCount, Model.SchedulePage + 2);
}
<div class="schedule-pagination" aria-label="Manuscript schedule pages">
    <span class="schedule-pagination-summary">Showing @showingFrom-@showingTo of @Model.ScheduleTotalCount titles</span>
    <div class="schedule-pagination-controls">
        @if (Model.SchedulePage > 1)
        {
            <a class="schedule-page-link" href="@Url.Action("schedulemanagement", "ScheduleManagement", new { page = Model.SchedulePage - 1 })">Previous</a>
        }
        @for (int pageNumber = firstPageLink; pageNumber <= lastPageLink; pageNumber++)
        {
            bool isCurrentPage = pageNumber == Model.SchedulePage;
            string pageClass = isCurrentPage ? "active" : "";
            string currentPageAttr = isCurrentPage ? "page" : "";
            <a class="schedule-page-link @pageClass" href="@Url.Action("schedulemanagement", "ScheduleManagement", new { page = pageNumber })" aria-current="@currentPageAttr">@pageNumber</a>
        }
        @if (Model.SchedulePage < Model.SchedulePageCount)
        {
            <a class="schedule-page-link" href="@Url.Action("schedulemanagement", "ScheduleManagement", new { page = Model.SchedulePage + 1 })">Next</a>
        }
    </div>
</div>


@Html.Partial("_ScheduleModal", Model)

<script src="@Url.Content("~/Scripts/capstonecoordinator-app.js")?v=2.0"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
<script src="@Url.Content("~/Scripts/coordinator-schedule-modal.js")?v=1.6"></script>
<script>
    (function () {
        // each "View" button opens the pop-up of its schedule (the data comes from the database)
        document.getElementById("scheduleTable").addEventListener("click", function (e) {
            var btn = e.target.closest ? e.target.closest(".btn-view") : null;
            if (btn) CCSchedule.open(btn.getAttribute("data-id"));
        });


        // Notify PM: reminds every project manager who has not submitted a manuscript yet
        var notifyBtn = document.getElementById("btnNotifyPm");
        if (notifyBtn) notifyBtn.addEventListener("click", function () {
            if (notifyBtn.disabled) return;
            notifyBtn.disabled = true;
            fetch("@Url.Action("notifyPms", "CoordinatorApi", new { area = "CapstoneCoordinator" })", {
                method: "POST",
                credentials: "same-origin",
                cache: "no-store",
                headers: { "X-Requested-With": "XMLHttpRequest" }
            })
                .then(function (r) { return r.json(); })
                .then(function (res) {
                    if (res && res.unauthorized) { window.location.href = "/Auth/Login/login"; return; }
                    if (res && res.success) {
                        if (res.total === 0) Notice.info("Nothing to send", res.message);
                        else Notice.success("Notification sent", res.message);
                    } else {
                        Notice.error("Could not notify", (res && res.message) || "Please try again.");
                    }
                })
                .catch(function () { Notice.error("Could not notify", "Please check your connection and try again."); })
                .then(function () { notifyBtn.disabled = false; });
        });
    })();
</script>
