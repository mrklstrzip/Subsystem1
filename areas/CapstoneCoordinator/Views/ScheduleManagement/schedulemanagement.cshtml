@using System.Linq
@using Subsystem1.Areas.CapstoneCoordinator.Models
@model CoordinatorData
@{
    ViewBag.Title = "Manuscript Management";
}

<link href="@Url.Content("~/Content/css/capstonecoordinator/schedulemanagement.css")?v=4.6" rel="stylesheet" type="text/css" />

<!-- Header Banner -->
<div class="dashboard-header">
    <div class="header-text">
        <h1 class="page-title">Manuscript Management</h1>
        <p class="welcome-text">Generate and edit schedule</p>
    </div>
    <div class="header-bg-icon">
        <i class="fa fa-file-lines"></i>
    </div>
</div>

<!-- Controls Container Card -->
<div class="controls-card">
    <div class="search-container">
        <div class="search">
            <i class="fa fa-search"></i>
            <input type="text" id="searchInput" placeholder="Search">
        </div>
    </div>

    <div class="filter-wrapper">
        <div class="custom-select-box">
            <span class="filter-legend">Section</span>
            <div class="select-selected">
                <i class="fa-solid fa-people-group"></i>
                <span>All</span>
                <i class="fa-solid fa-chevron-down chevron"></i>
            </div>
        </div>

        <!-- Status Filter Box -->
        <div class="custom-select-box">
            <span class="filter-legend">Status</span>
            <div class="select-selected">
                <i class="fa-solid fa-sliders"></i>
                <span>All</span>
                <i class="fa-solid fa-chevron-down chevron"></i>
            </div>
        </div>

        <!-- Adviser Filter Box -->
        <div class="custom-select-box">
            <span class="filter-legend">Adviser</span>
            <div class="select-selected">
                <i class="fa-solid fa-chalkboard-user"></i>
                <span>All</span>
                <i class="fa-solid fa-chevron-down chevron"></i>
            </div>
        </div>

        <!-- Notify PM Button -->
        <button type="button" class="btn-notify-pm" id="btnNotifyPm">
            <i class="fa-solid fa-bell"></i>
            <span>Notify PM</span>
        </button>
    </div>
</div>

<!-- Schedule Management Table Section -->
<div class="schedule-management-card">
    <table class="schedule-table" id="scheduleTable">
        <thead>
            <tr>
                <th class="column-title manuscript-col">MANUSCRIPT</th>
                <th class="column-title author-col">PROJECT MANAGER</th>
                <th class="column-title section-col">SECTION</th>
                <th class="column-title adviser-col">ADVISER</th>
                <th class="column-title type-col">TYPE</th>
                <th class="column-title date-col">DATE</th>
                <th class="column-title manuscript-status-col">MANUSCRIPT STATUS</th>
                <th class="column-title dean-status-col">DEAN STATUS</th>
                <th class="column-title action-col">ACTION</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in Model.Schedules)
            {
                <tr data-id="@s.Id" data-sy="@s.SchoolYear" data-program="@s.Program" data-section="@s.Section" data-manuscript-status="@(!String.IsNullOrWhiteSpace(s.Title) ? "Submitted" : "Not submitted")" data-dean-status="@s.StatusLabel">
                    <td class="manuscript-title-cell">@s.Title</td>
                    <td class="author-cell"><div class="manuscript-title-text">@s.Author</div></td>
                    <td class="section-cell">@s.Section</td>
                    <td class="adviser-cell">@s.Adviser</td>
                    <td class="type-cell">
                        @if (String.IsNullOrWhiteSpace(s.Type))
                        {
                            <span class="status-empty">—</span>
                        }
                        else
                        {
                            <span class="defense-type-badge @s.TypeClass">@s.Type</span>
                        }
                    </td>
                    <td class="date-cell">@s.DateText</td>
                    <td>
                        <span class="status-badge @(!String.IsNullOrWhiteSpace(s.Title) ? "submitted" : "not-submitted")">@(!String.IsNullOrWhiteSpace(s.Title) ? "Submitted" : "Not submitted")</span>
                    </td>
                    <td>
                        @if (s.Status == "")
                        {
                            <span class="status-empty">—</span>
                        }
                        else
                        {
                            <span class="status-badge @s.Status">@s.StatusLabel</span>
                        }
                    </td>
                    <td class="action-cell">
                        @if (!String.IsNullOrWhiteSpace(s.Title))
                        {
                            <button class="btn-view" type="button" data-id="@s.Id" data-has-schedule="@(!s.Id.StartsWith("roster-", StringComparison.OrdinalIgnoreCase) ? "true" : "false")" data-manuscript-id="@(s.Id.StartsWith("roster-", StringComparison.OrdinalIgnoreCase) ? s.Id.Substring(7) : "")">View</button>
                        }
                        else
                        {
                            <span class="no-action">&mdash;</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="schedule-pagination" id="schedulePagination" aria-label="Manuscript schedule pages">
    <span class="schedule-pagination-summary" id="schedulePaginationSummary" aria-live="polite"></span>
    <div class="schedule-pagination-controls" id="schedulePaginationControls"></div>
</div>


@Html.Partial("_ScheduleModal", Model)

<script src="@Url.Content("~/Scripts/capstonecoordinator-app.js")?v=2.5"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
<script src="@Url.Content("~/Scripts/coordinator-schedule-modal.js")?v=1.7"></script>
<script>
    (function () {
        // each "View" button opens the pop-up of its schedule (the data comes from the database)
        document.getElementById("scheduleTable").addEventListener("click", function (e) {
            var btn = e.target.closest ? e.target.closest(".btn-view") : null;
            if (!btn) return;
            if (btn.getAttribute("data-has-schedule") === "true") {
                CCSchedule.open(btn.getAttribute("data-id"));
                return;
            }
            var manuscriptId = btn.getAttribute("data-manuscript-id");
            if (!manuscriptId) return;

            var originalText = btn.textContent;
            btn.disabled = true;
            btn.textContent = "Preparing...";
            fetch("@Url.Action("ensureSchedule", "CoordinatorApi", new { area = "CapstoneCoordinator" })?versionId=" + encodeURIComponent(manuscriptId), {
                method: "GET",
                credentials: "same-origin",
                cache: "no-store",
                headers: { "X-Requested-With": "XMLHttpRequest" }
            }).then(function (response) {
                return response.text().then(function (text) {
                    var result;
                    try { result = JSON.parse(text); }
                    catch (parseError) {
                        throw new Error("Schedule service returned HTTP " + response.status + " instead of JSON. Rebuild and restart the web app, then try again.");
                    }
                    if (!response.ok) throw new Error((result && result.message) || ("Schedule service returned HTTP " + response.status + "."));
                    return result;
                });
            })
                .then(function (result) {
                    if (result && result.unauthorized) { window.location.href = "/Auth/Login/login"; return; }
                    if (!result || !result.success || !result.scheduleId) {
                        if (window.Notice) Notice.error("Schedule unavailable", (result && result.message) || "Could not prepare the generated schedule.");
                        else window.alert((result && result.message) || "Could not prepare the generated schedule.");
                        return;
                    }
                    btn.setAttribute("data-id", result.scheduleId);
                    btn.setAttribute("data-has-schedule", "true");
                    btn.removeAttribute("data-manuscript-id");
                    var row = btn.closest("tr");
                    if (row) {
                        row.setAttribute("data-id", result.scheduleId);
                        var dateCell = row.querySelector(".date-cell");
                        var dateParts = String(result.date || "").split("-");
                        if (dateCell && dateParts.length === 3)
                            dateCell.textContent = dateParts[1] + "-" + dateParts[2].slice(0, 2) + "-" + dateParts[0].slice(-2);
                    }
                    CCSchedule.open(result.scheduleId);
                }).catch(function (error) {
                    var message = error && error.message ? error.message : "Could not reach the server. Please try again.";
                    if (window.Notice) Notice.error("Schedule unavailable", message);
                    else window.alert(message);
                }).then(function () {
                    btn.disabled = false;
                    btn.textContent = originalText;
                });
        });


        // Notify PM: reminds every project manager who has not submitted a manuscript yet
        var notifyBtn = document.getElementById("btnNotifyPm");
        if (notifyBtn) notifyBtn.addEventListener("click", function () {
            if (notifyBtn.disabled) return;
            notifyBtn.disabled = true;
            fetch("@Url.Action("notifyPms", "CoordinatorApi", new { area = "CapstoneCoordinator" })", {
                method: "POST",
                credentials: "same-origin",
                cache: "no-store",
                headers: { "X-Requested-With": "XMLHttpRequest" }
            })
                .then(function (r) { return r.json(); })
                .then(function (res) {
                    if (res && res.unauthorized) { window.location.href = "/Auth/Login/login"; return; }
                    if (res && res.success) {
                        if (res.total === 0) Notice.info("Nothing to send", res.message);
                        else Notice.success("Notification sent", res.message);
                    } else {
                        Notice.error("Could not notify", (res && res.message) || "Please try again.");
                    }
                })
                .catch(function () { Notice.error("Could not notify", "Please check your connection and try again."); })
                .then(function () { notifyBtn.disabled = false; });
        });
    })();
</script>
