@using Subsystem1.Areas.CapstoneCoordinator.Models
@model IList<ClearedSubmission>
@{
    ViewBag.Title = "Completed Manuscripts";
}

<link href="@Url.Content("~/Content/css/capstonecoordinator/defenseschedule.css")?v=2.4" rel="stylesheet" type="text/css" />
<link href="@Url.Content("~/Content/css/capstonecoordinator/clearedsubmissions.css")?v=2.1" rel="stylesheet" type="text/css" />

<div class="dashboard-header">
    <div class="header-text">
        <h1 class="page-title">Completed Manuscripts</h1>
        <p class="welcome-text">View completed manuscripts filed by Administrative Support Staff. No coordinator approval is required.</p>
    </div>
    <div class="header-bg-icon"><i class="fa fa-circle-check"></i></div>
</div>

<div class="schedule-management-card completed-manuscripts-card">
    <div class="completed-manuscripts-table-wrap">
        <table class="schedule-table completed-manuscripts-table">
            <thead>
                <tr>
                    <th class="column-title completed-manuscript-col">MANUSCRIPT / GROUP</th>
                    <th class="column-title completed-program-col">PROGRAM</th>
                    <th class="column-title completed-repository-col">REPOSITORY STATUS</th>
                    <th class="column-title completed-action-col" aria-label="Actions">ACTION</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || Model.Count == 0)
                {
                    <tr class="no-results-row"><td colspan="4">Manuscripts appear here after support staff files them in the repository.</td></tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        var repositoryStatus = item.IsHistorical ? "Historical" : "Filed";
                        <tr>
                            <td data-label="Manuscript / group">
                                <div class="manuscript-title-text">@item.Title</div>
                                <span class="program-badge">@(String.IsNullOrWhiteSpace(item.ClearanceGroup) ? "Group not recorded" : item.ClearanceGroup)</span>
                            </td>
                            <td data-label="Program" class="author-cell">@item.Program @item.Section</td>
                            <td data-label="Repository status"><span class="status-badge completed-repository-status">@repositoryStatus</span></td>
                            <td data-label="Action" class="completed-manuscript-action">
                                <a class="completed-view-button" href="@Url.Action("ViewManuscript", "ClearedSubmissions", new { area = "CapstoneCoordinator", id = item.Id })">View manuscript <span aria-hidden="true">→</span></a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
