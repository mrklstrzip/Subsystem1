@{
    ViewBag.Title = "Profile";
}

<link href="@Url.Content("~/Content/css/profile.css")?v=1.3" rel="stylesheet" type="text/css" />

<div class="pm role-staff">
    <section class="pm-banner">
        <div>
            <h1>Profile</h1>
            <p>Manage account credentials</p>
        </div>
        <i class="fa fa-circle-user pm-banner-icon"></i>
    </section>

    <div class="pm-profile-grid">
        <section class="pm-card">
            <h2 class="pm-card-title">Profile Information</h2>

            <div class="pm-profile-head">
                <span id="pmPhoto" class="pm-avatar pm-avatar--lg" aria-hidden="true"></span>
                <div class="pm-profile-head-details">
                    <strong id="pmHeadName" class="pm-profile-name"></strong>
                    <span id="pmHeadRole" class="pm-profile-role"></span>
                    <div class="pm-profile-edit-actions">
                        <button type="button" class="pm-secondary" id="editProfileBtn">Edit Profile</button>
                    </div>
                </div>
            </div>

            <table class="pm-info-table">
                <tbody id="profileTableBody">
                    <tr><td class="label">NAME</td><td class="info" id="infoName"></td></tr>
                    <tr><td class="label">ID</td><td class="info" id="infoNumber"></td></tr>
                    <tr><td class="label">ROLE</td><td class="info" id="infoRole"></td></tr>
                    <tr><td class="label">EMAIL</td><td class="info" id="infoEmail"></td></tr>
                </tbody>
            </table>
        </section>

        <section class="pm-card">
            <h2 class="pm-card-title">Change Password</h2>
            <form class="pm-pw-form" id="changePasswordForm" onsubmit="return false;">
                <label for="current-password">
                    Current password
                    <span class="pm-input"><input type="password" id="current-password" required /><i class="fa fa-eye toggle-password"></i></span>
                </label>
                <label for="new-password">
                    New password
                    <span class="pm-input"><input type="password" id="new-password" required /><i class="fa fa-eye toggle-password"></i></span>
                </label>
                <label for="confirm-password">
                    Confirm password
                    <span class="pm-input"><input type="password" id="confirm-password" required /><i class="fa fa-eye toggle-password"></i></span>
                </label>
                <div class="pm-pw-actions"><button type="submit" class="pm-primary">Confirm</button></div>
            </form>
        </section>
    </div>
</div>

<!-- Edit Profile pop-up -->
<div class="pm-modal" id="editProfileModal" hidden>
    <div class="pm-modal-card" role="dialog" aria-modal="true" aria-labelledby="editProfileTitle">
        <h2 class="pm-card-title" id="editProfileTitle">Edit Profile</h2>

            <form class="pm-edit-profile-form" id="editProfileForm" novalidate onsubmit="return false;">
                <label for="editFirstName">First name</label>
                <input type="text" id="editFirstName" maxlength="50" autocomplete="given-name" />

                <label for="editMiddleName">Middle name (optional)</label>
                <input type="text" id="editMiddleName" maxlength="50" autocomplete="additional-name" />

                <label for="editLastName">Last name</label>
                <input type="text" id="editLastName" maxlength="50" autocomplete="family-name" />

                <label for="editEmail">Email</label>
                <input type="email" id="editEmail" maxlength="254" autocomplete="email" />

                <div class="pm-edit-actions">
                    <button type="submit" class="pm-primary" id="saveProfileBtn">Save</button>
                    <button type="button" class="pm-secondary" id="cancelEditProfileBtn">Cancel</button>
                    <span class="pm-profile-message" id="profileEditMessage" role="status"></span>
                </div>
            </form>
    </div>
</div>

<script src="@Url.Content("~/Scripts/coordinator-profile.js")?v=2.1"></script>
