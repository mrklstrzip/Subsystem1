@{
    ViewBag.Title = "Conflict Result";
}

<link href="@Url.Content("~/Content/css/capstonecoordinator/conflictresult.css")?v=2.1" rel="stylesheet" type="text/css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<!-- Header Banner -->
<div class="dashboard-header">
    <div class="header-text">
        <span class="breadcrumb-text">Capstone Coordinator / Conflict Result</span>
        <h1 class="page-title">Conflict Result</h1>
        <p class="welcome-text">View and resolve defense conflict</p>
    </div>
    <div class="header-bg-icon">
        <i class="fa fa-calendar-days"></i>
    </div>
</div>

<!-- Controls Container Card -->
<div class="controls-card">
    <div class="search-container">
        <div class="search">
            <i class="fa fa-search"></i>
            <input type="text" id="searchInput" placeholder="Search">
        </div>
    </div>

    <div class="filter-wrapper">
        <!-- Room Filter Box -->
        <!-- Status Filter Box -->
        <div class="custom-select-box">
            <span class="filter-legend">Status</span>
            <div class="select-selected">
                <i class="fa-solid fa-sliders"></i>
                <span>All</span>
                <i class="fa-solid fa-chevron-down chevron"></i>
            </div>
        </div>
    </div>
</div>

<!-- Conflict Result Table Section (click a row to open its Conflict Report) -->
