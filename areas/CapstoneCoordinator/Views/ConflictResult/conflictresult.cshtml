@using System.Linq
@using Subsystem1.Areas.CapstoneCoordinator.Models
@model CoordinatorData
@{
    ViewBag.Title = "Under Review";
}

<link href="@Url.Content("~/Content/css/capstonecoordinator/conflictresult.css")?v=2.2" rel="stylesheet" type="text/css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<!-- Header Banner -->
<div class="dashboard-header">
    <div class="header-text">
        <h1 class="page-title">Under Review</h1>
        <p class="welcome-text">View and resolve defense conflict</p>
    </div>
    <div class="header-bg-icon">
        <i class="fa fa-clipboard-list"></i>
    </div>
</div>

<!-- Controls Container Card -->
<div class="controls-card">
    <div class="search-container">
        <div class="search">
            <i class="fa fa-search"></i>
            <input type="text" id="searchInput" placeholder="Search">
        </div>
    </div>

    <div class="filter-wrapper">
        <!-- Status Filter Box -->
        <div class="custom-select-box">
            <span class="filter-legend">Status</span>
            <div class="select-selected">
                <i class="fa-solid fa-sliders"></i>
                <span>All</span>
                <i class="fa-solid fa-chevron-down chevron"></i>
            </div>
        </div>
    </div>
</div>

<div class="schedule-management-card">
    <table class="schedule-table" id="conflictTable">
        <thead>
            <tr>
                <th class="column-title manuscript-col">MANUSCRIPT</th>
                <th class="column-title room-col">ROOM</th>
                <th class="column-title type-col">CONFLICT TYPE</th>
                <th class="column-title desc-col">DESCRIPTION</th>
                <th class="column-title date-col">DETECTED DATE</th>
                <th class="column-title date-col">RESOLVED DATE</th>
                <th class="column-title status-col">STATUS</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model.Conflicts)
            {
                <tr class="clickable-row" tabindex="0" data-id="@c.ScheduleId"
                    data-status="@(c.Resolved ? "resolved" : "in-progress")" data-steps-done="@c.StepsDone"
                    data-type="@c.Type" data-description="@c.Description"
                    data-steps="@(string.Join("\n", c.Steps.Select(s => s.Key + "\t" + s.Value)))">
                    <td>
                        <div class="manuscript-title-text">@c.Title</div>
                        <span class="program-badge @c.BadgeClass">@c.Badge</span>
                    </td>
                    <td class="room-cell">@c.Room</td>
                    <td class="conflict-cell">@c.Type</td>
                    <td class="desc-cell">@c.Description</td>
                    <td class="date-cell">@c.DetectedText</td>
                    <td class="date-cell">@c.ResolvedText</td>
                    <td>
                        <span class="status-badge @(c.Resolved ? "resolved" : "in-progress")">@(c.Resolved ? "Resolved" : "In Progress")</span>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- ==========================================================
     MODAL 1: Conflict Report
     in-progress -> Close + Resolve (last step greyed out)
     resolved    -> Close only (all steps done)
     ========================================================== -->
<div class="modal-overlay" id="reportModal" aria-hidden="true">
    <div class="schedule-modal report-modal" role="dialog" aria-modal="true" aria-labelledby="reportHeading">

        <button type="button" class="modal-close-icon" id="reportCloseIcon" aria-label="Close">
            <i class="fa-solid fa-xmark"></i>
        </button>

        <h2 class="modal-heading" id="reportHeading">Conflict Report</h2>
        <p class="report-subheading" id="rSubheading"></p>

        <div class="report-grid">
            <aside class="report-side">
                <div class="side-item">
                    <span class="summary-label">Room</span>
                    <span class="summary-value" id="rRoom"></span>
                </div>
                <div class="side-item">
                    <span class="summary-label">Conflict Type</span>
                    <span class="summary-value" id="rType"></span>
                </div>
                <div class="side-item">
                    <span class="summary-label">Description</span>
                    <span class="summary-value" id="rDescription"></span>
                </div>
                <div class="side-item">
                    <span class="summary-label">Detected At</span>
                    <span class="summary-value" id="rDetected"></span>
                </div>
                <div class="side-item">
                    <span class="summary-label">Resolved At</span>
                    <span class="summary-value" id="rResolved"></span>
                </div>
                <div class="side-item">
                    <span class="summary-label">Current Status</span>
                    <span class="report-status" id="rStatus"></span>
                </div>
            </aside>

            <section class="report-steps" id="rSteps"></section>
        </div>

        <div class="modal-footer">
            <button type="button" class="btn-modal btn-modal-close" id="reportCloseBtn">Close</button>
            <button type="button" class="btn-modal btn-modal-submit" id="reportResolveBtn">Resolve</button>
        </div>
    </div>
</div>

<!-- ==========================================================
     MODAL 2: Generated Schedule (Under Review) - same popup as
     Schedule Management. Opens when "Resolve" is clicked.
     ========================================================== -->
<div class="modal-overlay" id="scheduleModal" aria-hidden="true">
    <div class="schedule-modal" role="dialog" aria-modal="true" aria-labelledby="modalHeading">

        <button type="button" class="modal-close-icon" id="modalCloseIcon" aria-label="Close">
            <i class="fa-solid fa-xmark"></i>
        </button>

        <h2 class="modal-heading" id="modalHeading">Generated Schedule</h2>
        <p class="modal-subheading">College of Computer Studies - QCU &nbsp;·&nbsp; Defense Schedule</p>

        <!-- Summary card -->
        <div class="modal-summary">
            <div class="summary-row summary-row-4">
                <div class="summary-item">
                    <span class="summary-label">Project Title</span>
                    <span class="summary-value" id="mTitle"></span>
                </div>
                <div class="summary-item">
                    <span class="summary-label">Date Submitted</span>
                    <span class="summary-value" id="mDateSubmitted"></span>
                </div>
                <div class="summary-item">
                    <span class="summary-label">Problem</span>
                    <span class="summary-value" id="mProblem"></span>
                </div>
                <div class="summary-item">
                    <span class="summary-label">Current Status</span>
                    <span class="status-badge under-review" id="mStatus">Under Review</span>
                </div>
            </div>
            <div class="summary-divider"></div>
            <div class="summary-row summary-row-3">
                <div class="summary-item">
                    <span class="summary-label">Student</span>
                    <span class="summary-value" id="mStudent"></span>
                </div>
                <div class="summary-item">
                    <span class="summary-label">Program</span>
                    <span class="summary-value" id="mProgram"></span>
                </div>
                <div class="summary-item">
                    <span class="summary-label">Adviser</span>
                    <span class="summary-value" id="mAdviser"></span>
                </div>
            </div>
        </div>

        <!-- Body: Abstract + Panelists -->
        <div class="modal-body-grid">
            <div class="modal-panel abstract-panel">
                <h3 class="panel-title">Abstract</h3>
                <p class="panel-text" id="mAbstract"></p>

                <h3 class="panel-title">Keywords</h3>
                <p class="panel-text" id="mKeywords"></p>

                <span class="panel-footnote" id="mSubmittedNote"></span>
            </div>

            <div class="modal-panel panelists-panel">
                <div class="panel-header-row">
                    <h3 class="panel-title no-margin">Assigned Panelists</h3>
                    <div class="edit-actions">
                        <button type="button" class="btn-edit-panelists" id="btnEditPanelists" title="Edit panelists and schedule">
                            <i class="fa-solid fa-pen"></i>
                        </button>
                        <button type="button" class="btn-edit-panelists btn-cancel-edit" id="btnCancelEdit" title="Cancel" hidden>
                            <i class="fa-solid fa-xmark"></i>
                        </button>
                        <button type="button" class="btn-edit-panelists btn-save-edit" id="btnSaveEdit" title="Save changes" hidden>
                            <i class="fa-solid fa-check"></i>
                        </button>
                    </div>
                </div>

                <div class="panelist-head">
                    <span>Panelists</span>
                    <span>Expertise Match</span>
                </div>
                <div id="mPanelists"></div>

                <h3 class="panel-title schedule-title">Proposed Defense Schedule</h3>
                <dl class="defense-schedule">
                    <div>
                        <dt>TIME</dt>
                        <dd>
                            <span class="view-val" id="mTime"></span>
                            <span class="edit-val">
                                <input type="time" class="edit-input" id="eTimeStart" aria-label="Start time">
                                <span class="time-sep">&ndash;</span>
                                <input type="time" class="edit-input" id="eTimeEnd" aria-label="End time">
                            </span>
                        </dd>
                    </div>
                    <div>
                        <dt>DATE</dt>
                        <dd>
                            <span class="view-val" id="mDate"></span>
                            <span class="edit-val">
                                <input type="date" class="edit-input" id="eDate" aria-label="Defense date">
                            </span>
                        </dd>
                    </div>
                    <div>
                        <dt>ROOM</dt>
                        <dd>
                            <span class="view-val" id="mRoom"></span>
                            <span class="edit-val">
                                <input type="text" class="edit-input room-input" id="eRoom" maxlength="20" aria-label="Room">
                            </span>
                        </dd>
                    </div>
                </dl>
                <p class="edit-error" id="mEditError" hidden></p>
            </div>
        </div>

        <!-- Footer buttons -->
        <div class="modal-footer">
            <button type="button" class="btn-modal btn-modal-close" id="modalCloseBtn">Close</button>
            <button type="button" class="btn-modal btn-modal-submit" id="modalSubmitBtn">Submit</button>
        </div>
    </div>
</div>


<datalist id="facultyList">
    @foreach (var n in Model.FacultyNames)
    {
        <option value="@n"></option>
    }
</datalist>
<datalist id="roomList">
    @foreach (var n in Model.RoomNames)
    {
        <option value="@n"></option>
    }
</datalist>

<script src="@Url.Content("~/Scripts/capstonecoordinator-app.js")?v=2.0"></script>
<script src="@Url.Content("~/Scripts/coordinator-schedule-modal.js")?v=1.0"></script>
<script>
    (function () {
        function $(id) { return document.getElementById(id); }
        function dash(txt) { txt = (txt || "").trim(); return /^-+$/.test(txt) || !txt ? "\u2014" : txt; }

        var currentRow = null;
        var reportOverlay = $("reportModal");
        var resolveBtn = $("reportResolveBtn");

        // "title<TAB>text" lines saved by the server in the row
        function stepsOf(row) {
            return (row.getAttribute("data-steps") || "").split("\n").filter(Boolean).map(function (line) {
                var i = line.indexOf("\t");
                return { title: line.slice(0, i), text: line.slice(i + 1) };
            });
        }

        function openReport(row) {
            currentRow = row;
            var d = row.dataset;
            var cells = row.querySelectorAll(".date-cell");
            var isResolved = d.status === "resolved";

            $("rSubheading").textContent = row.querySelector(".manuscript-title-text").textContent + " - " + row.querySelector(".program-badge").textContent;
            $("rRoom").textContent = dash(row.querySelector(".room-cell").textContent);
            $("rType").textContent = d.type;
            $("rDescription").textContent = d.description;
            $("rDetected").textContent = cells[0].textContent.trim();
            $("rResolved").textContent = dash(cells[1].textContent);

            var st = $("rStatus");
            st.className = "report-status " + d.status;
            st.textContent = isResolved ? "Resolved" : "In Progress";

            // Steps: the first N are done, the rest are greyed out
            var done = parseInt(d.stepsDone, 10) || 0;
            var wrap = $("rSteps");
            wrap.innerHTML = "";
            stepsOf(row).forEach(function (s, i) {
                var stepRow = document.createElement("div");
                stepRow.className = "step-row" + (i < done ? "" : " pending");

                var head = document.createElement("div");
                head.className = "step-head";
                var dot = document.createElement("span");
                dot.className = "step-dot";
                var label = document.createElement("div");
                label.className = "step-label";
                label.textContent = "STEP " + (i + 1) + ":";
                label.appendChild(document.createElement("br"));
                label.appendChild(document.createTextNode(s.title));
                head.appendChild(dot);
                head.appendChild(label);

                var text = document.createElement("p");
                text.className = "step-text";
                text.textContent = s.text;

                stepRow.appendChild(head);
                stepRow.appendChild(text);
                wrap.appendChild(stepRow);
            });

            resolveBtn.style.display = isResolved ? "none" : "";

            reportOverlay.classList.add("open");
            reportOverlay.setAttribute("aria-hidden", "false");
            document.body.classList.add("modal-open");
        }

        function closeReport() {
            reportOverlay.classList.remove("open");
            reportOverlay.setAttribute("aria-hidden", "true");
            document.body.classList.remove("modal-open");
        }

        document.querySelectorAll(".clickable-row").forEach(function (row) {
            row.addEventListener("click", function () { openReport(row); });
            row.addEventListener("keydown", function (e) {
                if (e.key === "Enter" || e.key === " ") { e.preventDefault(); openReport(row); }
            });
        });

        $("reportCloseIcon").addEventListener("click", closeReport);
        $("reportCloseBtn").addEventListener("click", closeReport);
        reportOverlay.addEventListener("click", function (e) { if (e.target === reportOverlay) closeReport(); });

        // RESOLVE -> the "Generated Schedule" pop-up: choose panelists / date / time / room, then Submit
        resolveBtn.addEventListener("click", function () {
            var id = currentRow.getAttribute("data-id");
            closeReport();
            CCSchedule.open(id);
        });
    })();
</script>
