                <td>
                    <div class="manuscript-title-text">Huwag na Huwag Mong Sasabihin</div>
                    <span class="program-badge bscs">BSCS-4A</span>
                </td>
                <td class="room-cell">IK505</td>
                <td class="conflict-cell">Lorem Ipsum</td>
                <td class="desc-cell">Sasuke Uchiha</td>
                <td class="date-cell">10-25-2027</td>
                <td class="date-cell">-------</td>
                <td>
                    <span class="status-badge in-progress">In Progress</span>
                </td>
            </tr>
            <tr class="clickable-row" tabindex="0"
                data-status="resolved" data-steps-done="4"
                data-type="Room Unavailability" data-description="Aircon Not Working"
                data-student="Apple D App" data-adviser="Bon Jovie"
                data-program="BS Information Systems · 4A" data-date-submitted="Sep 22, 2026">
                <td>
                    <div class="manuscript-title-text">Pangarap Lang Kita</div>
                    <span class="program-badge bsis">BSIS-4A</span>
                </td>
                <td class="room-cell">IK505</td>
                <td class="conflict-cell">Lorem Ipsum</td>
                <td class="desc-cell">Bon Jovie</td>
                <td class="date-cell">10-25-2027</td>
                <td class="date-cell">11-5-2027</td>
                <td>
                    <span class="status-badge resolved">Resolved</span>
                </td>
            </tr>
            <tr class="clickable-row" tabindex="0"
                data-status="in-progress" data-steps-done="3"
                data-type="Room Unavailability" data-description="Aircon Not Working"
                data-student="Bamboo" data-adviser="The Beatles"
                data-program="BS Computer Science · 4D" data-date-submitted="Sep 22, 2026">
                <td>
                    <div class="manuscript-title-text">The Greatest Love of All</div>
                    <span class="program-badge bscs-dark">BSCS-4D</span>
                </td>
                <td class="room-cell">IK505</td>
                <td class="conflict-cell">Lorem Ipsum</td>
                <td class="desc-cell">The Beatles</td>
