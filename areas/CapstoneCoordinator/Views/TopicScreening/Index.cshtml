@model IList<Subsystem1.Areas.CapstoneCoordinator.Models.TopicScreening>
@{
    Layout = "~/Areas/CapstoneCoordinator/Views/Shared/_CapstoneCoordinatorLayout.cshtml";
}

<div class="os-header">
    <h1>Topic Screening</h1>
    <p>Compare a proposed capstone topic with existing manuscripts in the shared repository. Similarity is a screening aid, not a plagiarism finding or approval decision.</p>
    <i class="fa fa-magnifying-glass-chart os-bg-icon"></i>
</div>

@if (TempData["Success"] != null) { <div class="os-alert os-alert-ok">@TempData["Success"]</div> }
@if (TempData["Error"] != null) { <div class="os-alert os-alert-err">@TempData["Error"]</div> }

<div class="os-card">
    <h3>Screen a proposed topic</h3>
    <form method="post" action="@Url.Action("Screen", "TopicScreening")">
        @Html.AntiForgeryToken()
        <div class="os-field">
            <label>Project title</label>
            <input name="Title" maxlength="240" required class="os-input" />
        </div>
        <div class="os-field">
            <label>Description / abstract</label>
            <textarea name="Description" maxlength="10000" rows="4" class="os-textarea"></textarea>
        </div>
        <button type="submit" class="os-btn">Run standard screening</button>
    </form>
</div>

<h3 style="margin:24px 0 12px;font-size:17px;font-weight:600">Recent screenings</h3>
@foreach (var s in Model)
{
    <div class="os-card">
        <div class="os-screen-head">
            <strong>@s.Title</strong>
            <span class="os-score">Highest overlap: <b>@s.HighestScore.ToString("0.0")%</b></span>
        </div>
        <div class="os-note">@s.CreatedAt.ToLocalTime().ToString("MMM d, yyyy h:mm tt") · compared with @s.RepositoryCount records</div>
        @if (s.Matches != null)
        {
            <div class="os-table-wrap" style="margin-top:12px">
                <table class="os-table">
                    <thead><tr><th>Existing manuscript</th><th>Program</th><th>Similarity</th><th>Signal</th></tr></thead>
                    <tbody>
                        @foreach (var m in s.Matches)
                        {
                            <tr><td>@m.Title</td><td>@m.Program</td><td>@m.Similarity.ToString("0.0")%</td><td>@m.MatchType</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        <form method="post" action="@Url.Action("SaveCase", "TopicScreening")" class="os-case-form">
            @Html.AntiForgeryToken()
            <input type="hidden" name="ScreeningId" value="@s.Id" />
            <input type="hidden" name="Version" value="0" />
            <div class="os-row">
                <select name="Status" class="os-select">
                    <option>Reviewing</option><option>Approved</option><option>Revision Required</option><option>Rejected</option>
                </select>
                <input name="Contribution" class="os-input" placeholder="Novel contribution (optional)" />
            </div>
            <textarea name="Notes" required placeholder="Human assessment notes and rationale" rows="2" class="os-textarea" style="margin-bottom:10px"></textarea>
            <button type="submit" class="os-btn">Save assessment case</button>
        </form>
    </div>
}
@if (Model.Count == 0)
{
    <div class="os-card os-empty">No screenings yet. Submit a proposed topic above to begin.</div>
}
