
@model IList<Subsystem1.Areas.CapstoneCoordinator.Models.TopicCase>
@{
    Layout = "~/Areas/CapstoneCoordinator/Views/Shared/_CapstoneCoordinatorLayout.cshtml";
    Func<string, string> PillClass = s => "os-pill os-" + (s ?? "").ToLowerInvariant().Replace(" ", "-");
}

<link href="@Url.Content("~/Content/css/capstonecoordinator/cases.css")?v=3.5" rel="stylesheet" type="text/css" />
<link href="@Url.Content("~/Content/css/capstonecoordinator/conflictresult.css")?v=2.2" rel="stylesheet" type="text/css" />

<div class="os-header">
    <h1>Assessment Cases</h1>
    <p>Human-reviewed recommendations and case notes.</p>
    <i class="fa fa-clipboard-check os-bg-icon"></i>
</div>

<div class="controls-card cases-controls">
    <div class="search-container"><div class="search"><i class="fa fa-search"></i><input type="text" id="searchInput" placeholder="Search cases" aria-label="Search assessment cases"></div></div>
    <div class="filter-wrapper"><div class="custom-select-box"><span class="filter-legend">Status</span><div class="select-selected"><i class="fa-solid fa-sliders"></i><span>All</span><i class="fa-solid fa-chevron-down chevron"></i></div></div></div>
</div>
<div class="cases-management-card">
    <table class="cases-table" id="assessmentCasesTable">
        <thead>
            <tr>
                <th class="column-title">Reference</th>
                <th class="column-title">Topic</th>
                <th class="column-title">Status</th>
                <th class="column-title">Notes</th>
                <th class="column-title">Updated</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Count > 0)
            {
                foreach (var c in Model)
                {
                    <tr>
                        <td>@c.Reference</td>
                        <td>@c.Title</td>
                        <td>
                            <span class="@PillClass(c.Status)">@c.Status</span>
                        </td>
                        <td>@c.Notes</td>
                        <td>@c.UpdatedAt.ToLocalTime().ToString("MMM d, yyyy")</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="cases-empty">
                        No assessment cases yet. Save one from a screening result.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
<script src="@Url.Content("~/Scripts/capstonecoordinator-app.js")?v=2.1"></script>
