@{
    ViewBag.Title = "PM Invitations";
}

<link href="@Url.Content("~/Content/css/capstonecoordinator/conflictresult.css")?v=2.2" rel="stylesheet" type="text/css" />
<link href="@Url.Content("~/Content/css/capstonecoordinator/invitations.css")?v=1.0" rel="stylesheet" type="text/css" />

<style>
    /* Status filter: same look as the filters in schedulemanagement.
       The box/legend/dropdown styles come from conflictresult.css;
       only the small differences are handled here. */
    #invStatusBox .inv-native-select {
        display: none !important; /* the real <select id="invStatus"> stays in the page for the existing script */
    }

    #invStatusBox .select-option.selected {
        background: #223249;
        color: #FFFFFF;
    }
</style>

<!-- Header Banner -->
<div class="dashboard-header">
    <div class="header-text">
        <h1 class="page-title">PM Invitations</h1>
        <p class="welcome-text">Validate students as Project Managers. They get an email with a link to sign up.</p>
    </div>
    <div class="header-bg-icon">
        <i class="fa fa-user-plus"></i>
    </div>
</div>

<!-- Controls -->
<div class="controls-card">
    <div class="search-container">
        <div class="search">
            <i class="fa fa-search"></i>
            <input type="text" id="invSearch" placeholder="Search email">
        </div>
    </div>
    <div class="filter-wrapper">
        <!-- Status Filter Box (same design as schedulemanagement) -->
        <div class="custom-select-box" id="invStatusBox">
            <span class="filter-legend">Status</span>
            <div class="select-selected" tabindex="0" role="button" aria-haspopup="listbox" aria-expanded="false">
                <i class="fa-solid fa-sliders"></i>
                <span>All</span>
                <i class="fa-solid fa-chevron-down chevron"></i>
            </div>

            <!-- Kept as-is: the existing script reads and listens to this select -->
            <select id="invStatus" class="inv-native-select" aria-label="Filter by status">
                <option value="">All</option>
                <option value="pending">Pending</option>
                <option value="accepted">Signed up</option>
                <option value="expired">Expired</option>
                <option value="failed">Not sent</option>
                <option value="revoked">Cancelled</option>
            </select>
        </div>

        <button type="button" class="inv-btn inv-btn--primary" id="invOpen">
            <i class="fa fa-user-plus"></i> Invite Project Managers
        </button>
    </div>
</div>

<div class="schedule-management-card">
    <table class="schedule-table" id="invTable">
        <thead>
            <tr>
                <th class="column-title">EMAIL</th>
                <th class="column-title inv-col-status">STATUS</th>
                <th class="column-title inv-col-date">LAST SENT</th>
                <th class="column-title inv-col-date">LINK EXPIRES</th>
                <th class="column-title inv-col-actions">ACTIONS</th>
            </tr>
        </thead>
        <tbody id="invBody">
            <tr class="empty-row"><td colspan="5">Loading…</td></tr>
        </tbody>
    </table>
</div>

<!-- ==========================================================
     Modal: Add multiple users (Project Manager)
     ========================================================== -->
<div class="inv-overlay" id="invModal" aria-hidden="true">
    <div class="inv-modal" role="dialog" aria-modal="true" aria-labelledby="invTitle">

        <!-- step 1: the form -->
        <div id="invStepForm">
            <span class="inv-eyebrow">Account setup</span>
            <h2 class="inv-title" id="invTitle">Add multiple users</h2>

            <div class="inv-grid">
                <div class="inv-field">
                    <label class="inv-label" for="invEmailInput">Email addresses</label>
                    <div class="inv-chipbox" id="invChipBox">
                        <span id="invChips"></span>
                        <input type="text" id="invEmailInput" autocomplete="off" spellcheck="false"
                               placeholder="Add email addresses" aria-describedby="invHelp" />
                    </div>
                </div>
                <div class="inv-field">
                    <label class="inv-label" for="invRole">Role</label>
                    <select id="invRole" class="inv-select">
                        <option value="project-manager">Project Manager</option>
                    </select>
                </div>
            </div>

            <p class="inv-help" id="invHelp">Enter an address and press Enter, or paste multiple addresses separated by commas.</p>
            <p class="inv-error" id="invError" role="alert" hidden></p>

            <div class="inv-actions">
                <button type="button" class="inv-btn inv-btn--ghost" id="invCancel">Cancel</button>
                <button type="button" class="inv-btn inv-btn--primary" id="invSubmit">Send invitations</button>
            </div>
        </div>

        <!-- step 2: what happened to each address -->
        <div id="invStepDone" hidden>
            <span class="inv-eyebrow">Account setup</span>
            <h2 class="inv-title" id="invDoneTitle">Invitations</h2>
            <p class="inv-help" id="invDoneText"></p>
            <ul class="inv-results" id="invResults"></ul>
            <div class="inv-actions">
                <button type="button" class="inv-btn inv-btn--primary" id="invDone">Done</button>
            </div>
        </div>
    </div>
</div>

<div class="inv-toast" id="invToast" role="status" aria-live="polite" hidden></div>

<script src="@Url.Content("~/Scripts/coordinator-invitations.js")?v=1.0"></script>
<script>
    // Visual dropdown for the Status filter. The hidden <select id="invStatus"> stays the
    // source of truth: picking an option sets its value and fires its "change" event,
    // so coordinator-invitations.js works exactly as before.
    (function () {
        var box = document.getElementById("invStatusBox");
        var select = document.getElementById("invStatus");
        if (!box || !select) return;

        var toggle = box.querySelector(".select-selected");
        var label = toggle.querySelector("span");

        var menu = document.createElement("div");
        menu.className = "custom-select-dropdown";
        menu.setAttribute("role", "listbox");

        Array.prototype.forEach.call(select.options, function (o) {
            var el = document.createElement("div");
            el.className = "select-option";
            el.setAttribute("role", "option");
            el.setAttribute("data-value", o.value);
            el.textContent = o.textContent;
            menu.appendChild(el);
        });
        box.appendChild(menu);

        function syncFromSelect() {
            var current = select.value;
            var opts = menu.querySelectorAll(".select-option");
            for (var i = 0; i < opts.length; i++) {
                var on = opts[i].getAttribute("data-value") === current;
                opts[i].classList.toggle("selected", on);
                if (on) label.textContent = opts[i].textContent;
            }
        }

        function setOpen(on) {
            box.classList.toggle("open", on);
            menu.classList.toggle("open", on);
            toggle.setAttribute("aria-expanded", on ? "true" : "false");
        }

        toggle.addEventListener("click", function (e) {
            setOpen(!menu.classList.contains("open"));
            e.stopPropagation();
        });
        toggle.addEventListener("keydown", function (e) {
            if (e.key === "Enter" || e.key === " ") {
                e.preventDefault();
                setOpen(!menu.classList.contains("open"));
            }
        });

        menu.addEventListener("click", function (e) {
            var opt = e.target.closest(".select-option");
            if (!opt) return;
            select.value = opt.getAttribute("data-value");
            syncFromSelect();
            setOpen(false);
            var evt;
            if (typeof Event === "function") evt = new Event("change", { bubbles: true });
            else { evt = document.createEvent("Event"); evt.initEvent("change", true, true); }
            select.dispatchEvent(evt);
            e.stopPropagation();
        });

        select.addEventListener("change", syncFromSelect);   // keeps the label right if the select changes elsewhere
        document.addEventListener("click", function () { setOpen(false); });
        document.addEventListener("keydown", function (e) { if (e.key === "Escape") setOpen(false); });

        syncFromSelect();
    })();
</script>
