@{
    ViewData["Title"] = "Advisory Classes";
}

<link href="@Url.Content("~/Content/fontawesome/css/all.min.css")?v=1.0" rel="stylesheet" />

<div class="av-page">
    <div class="dashboard-header">
        <div class="header-text">
            <span class="breadcrumb-text">Panelist | Advisory Classes</span>
            <h1 class="page-title">Advisory Classes</h1>
            <p class="welcome-text">Capstone groups you are advising</p>
        </div>
        <div class="header-bg-icon">
            <i class="fa fa-person-chalkboard"></i>
        </div>
    </div>

    <!-- Filters -->
    <div class="av-filters">
        <div class="av-filter">
            <label>Search</label>
            <input type="text" placeholder="Search title or group" />
        </div>
        <div class="av-filter">
            <label>Section</label>
            <select>
                <option>Select Section</option>
                <option>SBIT-4E</option>
                <option>SBCS-4A</option>
            </select>
        </div>
    </div>

    <!-- Manuscript cards -->
    <div class="av-ms-grid">

        <div class="av-ms-card">
            <div class="av-ms-thumb">
                <div class="av-ms-doc"><i></i><i></i><i></i><i></i><i></i></div>
            </div>
            <div class="av-ms-info">
                <b>Manuscript Title</b>
                <small><span>Group 5</span><span>Section</span></small>
                <a class="av-btn av-btn-outline" href="#">View Details</a>
            </div>
        </div>

        <div class="av-ms-card">
            <div class="av-ms-thumb">
                <div class="av-ms-doc"><i></i><i></i><i></i><i></i><i></i></div>
            </div>
            <div class="av-ms-info">
                <b>Manuscript Title</b>
                <small><span>Group 5</span><span>Section</span></small>
                <a class="av-btn av-btn-outline" href="#">View Details</a>
            </div>
        </div>

    </div>
</div>