@{
    ViewData["Title"] = "Advisory Classes";
}

<div class="av-page">

    <!-- Banner -->
    <div class="av-banner">
        <div>
            <h1>Advisory Classes</h1>
            <p>Capstone groups you are advising</p>
        </div>
        <svg class="av-banner-deco" viewBox="0 0 96 96" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="26" cy="22" r="10" />
            <path d="M26 34v30M26 44l30-6M26 64l-8 24M26 64l10 24" />
            <rect x="50" y="12" width="42" height="40" rx="4" />
        </svg>
    </div>

    <!-- Filters -->
    <div class="av-filters">
        <div class="av-filter">
            <label>Search</label>
            <input type="text" placeholder="Search title or group" />
        </div>
        <div class="av-filter">
            <label>Section</label>
            <select>
                <option>Select Section</option>
                <option>SBIT-4E</option>
                <option>SBCS-4A</option>
            </select>
        </div>
    </div>

    <!-- Manuscript cards -->
    <div class="av-ms-grid">

        <div class="av-ms-card">
            <div class="av-ms-thumb">
                <div class="av-ms-doc"><i></i><i></i><i></i><i></i><i></i></div>
            </div>
            <div class="av-ms-info">
                <b>Manuscript Title</b>
                <small><span>Group 5</span><span>Section</span></small>
                <a class="av-btn av-btn-outline" href="#">View Details</a>
            </div>
        </div>

        <div class="av-ms-card">
            <div class="av-ms-thumb">
                <div class="av-ms-doc"><i></i><i></i><i></i><i></i><i></i></div>
            </div>
            <div class="av-ms-info">
                <b>Manuscript Title</b>
                <small><span>Group 5</span><span>Section</span></small>
                <a class="av-btn av-btn-outline" href="#">View Details</a>
            </div>
        </div>

    </div>
</div>