
@{
    ViewBag.Title = "Profile";
}

<div class="av-page">

    <div class="av-banner">
        <div>
            <h1>Profile</h1>
        </div>

        <svg class="av-banner-deco" viewBox="0 0 24 24"
             fill="none" stroke="currentColor" stroke-width="1.6"
             stroke-linecap="round">
            <path d="M21 12a9 9 0 1 0-4 7.5" />
            <circle cx="13" cy="9.5" r="3"
                    fill="currentColor" stroke="none" />
            <path d="M7.5 18.5a5.5 5.5 0 0 1 11 0z"
                  fill="currentColor" stroke="none" />
        </svg>
    </div>

    <div class="av-profile-grid">

        <!-- Profile Information -->
        <div class="av-pcard">
            <h3>Profile Information</h3>

            <div class="av-pinfo-head">
                <svg class="av-avatar" viewBox="0 0 90 110">
                    <ellipse cx="45" cy="55" rx="45" ry="55"
                             fill="#cfd6df" />
                    <circle cx="45" cy="42" r="17" fill="#fff" />
                    <path d="M12 98c4-24 20-32 33-32s29 8 33 32a45 55 0 0 1-66 0z"
                          fill="#fff" />
                </svg>

                <div>
                    <div class="av-pname">Cady Heron</div>
                    <div class="av-prole">Panelist</div>
                </div>
            </div>

            <div class="av-prow">
                <span>Name</span>
                <span>Cady Heron</span>
            </div>

            <div class="av-prow">
                <span>ID</span>
                <span>2X-XXXX</span>
            </div>

            <div class="av-prow">
                <span>Role</span>
                <span>Adviser</span>
            </div>

            <div class="av-prow">
                <span>Email</span>
                <span>adviser@qcu.edu.ph</span>
            </div>
        </div>

        <!-- Change Password -->
        <div class="av-pcard">
            <h3>Change Password</h3>

            <div class="av-field">
                <label for="curPass">Current password</label>
                <input type="password" id="curPass" />

                <label for="newPass">New password</label>
                <input type="password" id="newPass" />

                <label for="confPass">Confirm password</label>
                <input type="password" id="confPass" />
            </div>

            <div class="av-pfoot">
                <button type="button" class="av-confirm">
                    Confirm
                </button>
            </div>
        </div>

    </div>
</div>
